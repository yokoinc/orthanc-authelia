# To be included in the existing nginx.conf (inside the port 443 server
# block). Replaces the current /api-upload/ location, which hard-codes the CF
# Access secret.
#
# Required modules: http_auth_request (present in official nginx).

# ==================================================================
# Keepalive upstreams (place at the http {} level, once)
# ==================================================================
# upstream orthanc_backend {
#     server orthanc:8042;
#     keepalive 8;
# }
# upstream auth_backend {
#     server auth-service:8000;
#     keepalive 4;
# }

# ==================================================================
# /api-upload/: programmatic upload protected by CF Access
# ==================================================================
location /api-upload/ {
    # Delegates checking the CF header to auth-service, which compares it
    # with the value stored in Redis. 204 means OK, 403 means rejected.
    auth_request /_verify-cf;

    # Direct streaming for large STOW-RS uploads (up to 500 MB)
    proxy_request_buffering off;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    client_max_body_size 500m;

    # Defence in depth: hide the CF headers before Orthanc sees them, so a
    # future bug cannot log them in clear
    proxy_set_header CF-Access-Client-Id "";
    proxy_set_header CF-Access-Client-Secret "";

    # CAREFUL: adapt the target path to what already exists in YOUR config.
    # The trailing / strips the /api-upload/ prefix. Common options:
    #   proxy_pass http://orthanc_backend/instances;             # native ingest
    #   proxy_pass http://orthanc_backend/dicom-web/studies;     # STOW-RS
    #   proxy_pass http://orthanc_backend/;                      # passthrough
    proxy_pass http://orthanc_backend/;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# ==================================================================
# Internal subrequest called by auth_request
# ==================================================================
location = /_verify-cf {
    internal;
    proxy_pass http://auth_backend/api/internal/verify-cf;

    # auth_request: no body, just the headers
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";

    # We extract the CF headers from the original request and forward them
    # to auth-service under non-CF names, to avoid confusion with a possible
    # internal CF forward
    proxy_set_header X-CF-Client-Id     $http_cf_access_client_id;
    proxy_set_header X-CF-Client-Secret $http_cf_access_client_secret;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_read_timeout 2s;
    proxy_connect_timeout 1s;
}
