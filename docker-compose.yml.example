# ORTHANC-AUTHELIA STANDALONE - Complete medical imaging solution
# Bundled Postgres by default: clone + bootstrap.sh + docker compose up
# Includes PostgreSQL, Redis, Orthanc, OHIF, Authelia, and Nginx
#
# =============================================================================
# QUICK START (recommended)
# =============================================================================
#
#   git clone https://github.com/yokoinc/orthanc-authelia.git
#   cd orthanc-authelia
#   ./bootstrap.sh              # generates .env, copies the templates
#   docker compose up -d        # starts the services
#
# =============================================================================
# EXTERNAL DATABASE (advanced)
# =============================================================================
#
# If you already run a separate postgres (another docker stack, a managed
# database, etc.), create a docker-compose.override.yml at the root:
#
#   services:
#     postgres:
#       profiles: ["disabled"]     # never starts
#     orthanc:
#       networks:
#         - orthanc-network
#         - database                # your existing external network
#       environment:
#         - ORTHANC__POSTGRESQL__HOST=database
#   networks:
#     database:
#       external: true
#
# =============================================================================

services:
  # =============================================================================
  # DATABASE SERVICES
  # =============================================================================

  redis:
    image: redis:8.0-alpine
    container_name: orthanc-redis
    restart: unless-stopped
    # Redis holds the audit log -- who did what, and when. On a PACS that
    # traceability matters beyond convenience, and the defaults do not
    # guarantee it:
    #
    #   - without appendonly, Redis only writes periodic snapshots
    #     (save 3600 1: at best hourly, and only if there was a single
    #     write). An abrupt stop therefore loses up to an hour of log.
    #   - the image declares VOLUME /data, which creates an ANONYMOUS volume:
    #     unnamed, invisible in docker volume ls, wiped by a
    #     docker volume prune, and impossible to back up simply.
    #
    # appendonly writes every operation, with an fsync per second: the worst
    # case loss drops from an hour to a second, at a negligible cost given
    # this service's write volume.
    command: >
      redis-server
      --appendonly yes
      --appendfsync everysec
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - orthanc-network

  # ---------------------------------------------------------------------------
  # Bundled PostgreSQL: works out of the box on a fresh clone.
  # To use an external database, see the "EXTERNAL DATABASE" section above.
  # ---------------------------------------------------------------------------
  postgres:
    image: postgres:16-alpine
    container_name: orthanc-postgres
    restart: unless-stopped
    environment:
      - POSTGRES_DB=${POSTGRES_DB:-orthanc}
      - POSTGRES_USER=${POSTGRES_USER:-orthanc}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-orthanc}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - orthanc-network

  # =============================================================================
  # AUTHENTICATION SERVICES
  # =============================================================================
  
  auth-service:
    # The published image is used when available; otherwise it is built from
    # the repository. A fresh clone therefore starts even without access to
    # the registry. Use `docker compose build auth-service` to force a build.
    image: registry.yokoinc.ovh/orthanc-auth-service:1.0.16
    build:
      context: ./services/auth-service
    container_name: orthanc-auth-service
    restart: unless-stopped
    # Same reason as for authelia: the panel rewrites users_database.yml and
    # orthanc.json inside the repository. The files it creates must belong to
    # the user, not to root.
    user: "${PUID:-1000}:${PGID:-1000}"
    volumes:
      # Cross bind-mounts: auth-service edits the SAME host files that
      # authelia and orthanc read. Without these mounts the admin panel
      # writes into the container's ephemeral filesystem: the users it
      # creates are never seen by Authelia and vanish on restart.
      #
      # We mount DIRECTORIES, not files. Two reasons:
      #   1. Writes are atomic (write tmp + rename). A rename onto a file
      #      bind-mount fails with EBUSY -- the file is a mount point, it
      #      cannot be replaced.
      #   2. A rename creates a new inode. Other containers mounting the FILE
      #      would stay bound to the old inode and never see the changes.
      - ./services/authelia/config:/host/authelia-config:rw
      - ./services/orthanc/config:/host/orthanc-config:rw
      # Rotating backups (last 10), created before every write
      - ./data/admin-backups:/host/backups:rw
      # Application settings editable from the panel (interface language).
      # Deliberately kept apart from .env, which should only hold what docker
      # compose needs BEFORE starting a container: secrets, credentials,
      # PUID/PGID, SSL_MODE.
      - ./data/app-settings:/host/app-settings:rw
      # .env is mounted as a FILE rather than through its directory:
      # mounting the project root would give the container write access to
      # docker-compose.yml and to the scripts. auth-service therefore writes
      # in place (no rename, which is impossible on a file mount).
      # It lets the panel change the public URL; without this mount the API
      # answers 503 with the steps to follow, and the rest keeps working.
      - ./.env:/host/env/.env:rw
    environment:
      # Essential Configuration (from .env)
      # Fallback for earlier installations: the language now lives in
      # data/app-settings/settings.json and is changed from the panel. Empty
      # here therefore does not mean "English".
      - LANGUAGE=${LANGUAGE:-}
      - AUTH_USERNAME=${AUTH_USERNAME}
      - AUTH_PASSWORD=${AUTH_PASSWORD}
      - REDIS_HOST=redis
      # Semantic version shown in the token manager's footer.
      # Keep in sync with the image tag above (1.0.16) on every bump.
      - IMAGE_VERSION=1.0.16
      # Dedicated Orthanc account for POST /tools/reset (hot config reload).
      # Generated by bootstrap.sh into .env.
      - ORTHANC_URL=http://orthanc:8042
      # Docker proxy address, for the panel's restart button.
      # Empty means the feature is unavailable, which the panel states.
      - DOCKER_PROXY_URL=http://socket-proxy:2375
      - ORTHANC_CONTAINER=orthanc-server
      - ORTHANC_ADMIN_USER=${ORTHANC_ADMIN_USER:-}
      - ORTHANC_ADMIN_PASS=${ORTHANC_ADMIN_PASS:-}
      # Optional overrides (uncomment in .env if needed)
      - LOG_LEVEL=${LOG_LEVEL:-INFO}
      - DEFAULT_TOKEN_MAX_USES=${DEFAULT_TOKEN_MAX_USES:-50}
      - DEFAULT_TOKEN_VALIDITY_SECONDS=${DEFAULT_TOKEN_VALIDITY_SECONDS:-604800}
      - CACHE_VALIDITY_USER_SESSION=${CACHE_VALIDITY_USER_SESSION:-300}
      - CACHE_VALIDITY_SHARE_TOKEN=${CACHE_VALIDITY_SHARE_TOKEN:-60}
      - AUDIT_RETENTION_DAYS=${AUDIT_RETENTION_DAYS:-90}
      - JS_REFRESH_INTERVAL=${JS_REFRESH_INTERVAL:-30000}
      - JS_DEBUG_MODE=${JS_DEBUG_MODE:-false}
    depends_on:
      redis:
        condition: service_healthy
    networks:
      - orthanc-network

  authelia:
    image: authelia/authelia:4.39.5
    container_name: orthanc-authelia
    restart: unless-stopped
    # Authelia writes into ./services/authelia/config (session database,
    # user list). Without this line it runs as root and takes ownership of
    # the directory: reinstalling then fails on a "Permission denied", and
    # the repository's configuration files become unreadable to their owner.
    # PUID/PGID are filled in by bootstrap.sh with the current user's
    # identity.
    user: "${PUID:-1000}:${PGID:-1000}"
    depends_on:
      redis:
        condition: service_healthy
    volumes:
      - ./services/authelia/config:/config
    networks:
      - orthanc-network
    environment:
      - TZ=${TZ}
      - AUTHELIA_SESSION_SECRET=${AUTHELIA_SESSION_SECRET}
      - AUTHELIA_STORAGE_ENCRYPTION_KEY=${AUTHELIA_STORAGE_ENCRYPTION_KEY}
      - AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=${AUTHELIA_JWT_SECRET}
      - AUTHELIA_LOG_LEVEL=${AUTHELIA_LOG_LEVEL:-info}
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - REDIS_DB=0

  # ---------------------------------------------------------------------------
  # Restarting Orthanc from the panel
  # ---------------------------------------------------------------------------
  # Applying an Orthanc configuration change requires restarting its
  # container: the image regenerates /tmp/orthanc.json at startup, and that
  # file -- not ours -- is what the process reads. POST /tools/reset only
  # re-reads the generated file, so it sees no change at all.
  #
  # Remotely, SSH access is not always available: without this service, a
  # configuration change leaves the operator stuck inside their own panel.
  #
  # The Docker socket is NOT mounted into auth-service. Handing it to a
  # web-facing service would grant it the equivalent of root on the host: it
  # could create a privileged container, mount the root filesystem and break
  # out. This proxy exposes only the strict minimum, and is reachable only
  # from the
  # internal network -- no port is published.
  socket-proxy:
    image: tecnativa/docker-socket-proxy:0.3.0
    container_name: orthanc-socket-proxy
    restart: unless-stopped
    environment:
      # Everything is denied by default. We open the strict minimum:
      - POST=1            # without it the whole API is read-only
      - ALLOW_RESTARTS=1  # containers/<id>/restart (et stop, kill)
      #
      # CONTAINERS stays at 0, and that matters: with CONTAINERS=1, POST=1
      # opens ALL of /containers/*, including POST /containers/create. Verified --
      # a privileged container mounting the host root was accepted (201),
      # which is exactly the escape this mount must prevent. With
      # CONTAINERS=0, create and exec answer 403 and the restart
      # fonctionne toujours.
      - CONTAINERS=0
      # Explicitly denied, so that reading this file is enough to know what
      # is possible:
      - EXEC=0            # no command execution inside a container
      - IMAGES=0
      - VOLUMES=0
      - NETWORKS=0
      - SERVICES=0
      - SWARM=0
      - SECRETS=0
      - CONFIGS=0
      - NODES=0
      - TASKS=0
      - PLUGINS=0
      - SYSTEM=0
      - INFO=0
      - AUTH=0
      - BUILD=0
      - COMMIT=0
      - DISTRIBUTION=0
      - SESSION=0
    volumes:
      # Read-only: the proxy has no business modifying the socket itself.
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - orthanc-network

  # =============================================================================
  # PACS CORE SERVICES
  # =============================================================================
  
  orthanc:
    # Official Orthanc Team image (replaces jodogne/orthanc-plugins). Pin a specific
    # tag to know exactly which plugin versions ship; see release notes at
    # https://github.com/orthanc-server/orthanc-builder/blob/master/release-notes-docker-images.md
    image: orthancteam/orthanc:26.4.2
    container_name: orthanc-server
    restart: unless-stopped
    depends_on:
      auth-service:
        condition: service_started
      postgres:
        condition: service_healthy
    volumes:
      # Directory, not file: auth-service rewrites orthanc.json through
      # write-tmp + rename, which creates a new inode. A file bind-mount
      # fichier resterait colle a l'ancien inode et POST /tools/reset
      # rechargerait l'ancienne config. Orthanc scanne /etc/orthanc/*.json.
      - ./services/orthanc/config:/etc/orthanc:ro
    networks:
      - orthanc-network
    environment:
      # ORTHANC__* env vars override the values in orthanc.json. This avoids
      # hard-coding credentials and host into the JSON, and allows switching
      # from a bundled to an external database by editing .env or the
      # override file alone.
      - ORTHANC__POSTGRESQL__HOST=postgres
      - ORTHANC__POSTGRESQL__PORT=5432
      - ORTHANC__POSTGRESQL__DATABASE=${POSTGRES_DB:-orthanc}
      - ORTHANC__POSTGRESQL__USERNAME=${POSTGRES_USER:-orthanc}
      - ORTHANC__POSTGRESQL__PASSWORD=${POSTGRES_PASSWORD}
      # Authorization plugin credentials. These variables OVERRIDE
      # orthanc.json -- Orthanc says so at startup: "Authorization.
      # WebServicePassword has already been defined; it will be overwritten by
      # the value defined in env-var". bootstrap.sh writes the same values
      # into the JSON, from the same source (.env): no drift is possible.
      #
      # CAREFUL: after changing AUTH_PASSWORD in .env, you must
      #   docker compose up -d --force-recreate orthanc
      # A plain `restart` replays the container's frozen environment: the
      # plugin garde l'ancien mot de passe, /user/get-profile repond 401 et
      # toute l'API Orthanc renvoie 403.
      - ORTHANC__AUTHORIZATION__WEB_SERVICE_USERNAME=${AUTH_USERNAME}
      - ORTHANC__AUTHORIZATION__WEB_SERVICE_PASSWORD=${AUTH_PASSWORD}
      # Kept for scripts backward compat (some helpers still read POSTGRES_*)
      - POSTGRES_HOST=postgres
      - POSTGRES_PORT=5432
      - POSTGRES_DB=${POSTGRES_DB:-orthanc}
      - POSTGRES_USER=${POSTGRES_USER:-orthanc}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      # --- Plugin enablement (orthancteam) -----------------------------------
      # orthancteam/orthanc auto-discovers bundled plugins; an env var (or a
      # config section) is required to enable each. Plugins whose orthanc.json
      # section is present (PostgreSQL, DicomWeb, Authorization, Housekeeper,
      # OrthancExplorer2) auto-enable, but we set the env vars explicitly for
      # robustness and to enable plugins without a dedicated config section
      # (Stone, VolView).
      - AUTHORIZATION_PLUGIN_ENABLED=true
      - POSTGRESQL_PLUGIN_ENABLED=true
      - DICOM_WEB_PLUGIN_ENABLED=true
      - STONE_WEB_VIEWER_PLUGIN_ENABLED=true
      - HOUSEKEEPER_PLUGIN_ENABLED=true
      - VOLVIEW_PLUGIN_ENABLED=true
      - ORTHANC_EXPLORER_2_ENABLED=true
      - GDCM_PLUGIN_ENABLED=true

  # =============================================================================
  # MEDICAL IMAGING VIEWERS
  # =============================================================================
  
  ohif:
    # Same again: published image, or a local build otherwise. This build is
    # long (~15 min), OHIF being compiled from source -- the official
    # official ohif/app image cannot serve under /ohif/, its base path being
    # frozen at build time.
    image: registry.yokoinc.ovh/orthanc-ohif:3.11.0
    build:
      context: ./services/ohif
    container_name: orthanc-ohif
    restart: unless-stopped
    volumes:
      - ./services/ohif/config/app-config.js:/usr/share/nginx/html/ohif/app-config.js:ro
    depends_on:
      - orthanc
    networks:
      - orthanc-network

  # =============================================================================
  # REVERSE PROXY & LOAD BALANCER
  # =============================================================================
  
  nginx:
    # Image >= 1.1.0 no longer bakes the nginx config in: the templates are
    # bind-mounted from the host (see volumes below). Tags before 1.1.0 will
    # NOT start with these mounts because they expect the templates baked in.
    # Idem : image publiee, ou construction locale a defaut.
    image: registry.yokoinc.ovh/orthanc-nginx:1.1.0
    build:
      context: ./services/nginx
    container_name: orthanc-nginx
    restart: unless-stopped
    ports:
      - "30080:80"
      - "30443:443"
    volumes:
      - nginx-ssl:/etc/nginx/ssl
      # Bind-mount the nginx config from the host (git = source of truth).
      # The entrypoint runs envsubst on these and writes the resulting nginx.conf
      # and conf.d/*.conf to their normal /etc/nginx/ locations. Config tweaks
      # therefore deploy via:  edit files  ->  docker compose restart nginx
      # (no rebuild, no image push, no tag bump).
      - ./services/nginx/nginx.ssl.conf:/etc/nginx/templates/nginx.conf.template:ro
      - ./services/nginx/conf.d:/etc/nginx/conf.d.templates:ro
    environment:
      # Seule variable a renseigner : l'URL publique complete. Le nom
      # host name (DOMAIN) is derived from it by the entrypoint.
      - PUBLIC_URL=${PUBLIC_URL}
      - SSL_MODE=${SSL_MODE:-selfsigned}
      # Optional: enables POST /api-upload/instances for scripted DICOM uploads
      # (bypasses Authelia SSO, uses HTTP Basic auth instead).
      - UPLOAD_USER=${UPLOAD_USER:-}
      - UPLOAD_PASSWORD=${UPLOAD_PASSWORD:-}
    depends_on:
      - authelia
      - orthanc
      - ohif
      - auth-service
    networks:
      - orthanc-network

# =============================================================================
# PERSISTENT STORAGE
# =============================================================================

volumes:
  nginx-ssl:
    name: orthanc_nginx_ssl
  redis_data:
    name: orthanc_redis_data
  postgres_data:
    name: orthanc_postgres_data

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

networks:
  orthanc-network:
    name: orthanc-network
    driver: bridge