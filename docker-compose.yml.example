# ORTHANC-AUTHELIA STANDALONE - Complete medical imaging solution
# Postgres embarque par defaut = clone + bootstrap.sh + docker compose up
# Includes PostgreSQL, Redis, Orthanc, OHIF, Authelia, and Nginx
#
# =============================================================================
# QUICK START (recommended)
# =============================================================================
#
#   git clone https://github.com/yokoinc/orthanc-authelia.git
#   cd orthanc-authelia
#   ./bootstrap.sh              # genere .env + copie templates
#   docker compose up -d        # demarre les 6 services
#
# =============================================================================
# EXTERNAL DATABASE (advanced)
# =============================================================================
#
# Si tu as deja un postgres separe (autre stack docker, base managee, etc.),
# cree un docker-compose.override.yml a la racine :
#
#   services:
#     postgres:
#       profiles: ["disabled"]     # ne demarre jamais
#     orthanc:
#       networks:
#         - orthanc-network
#         - database                # ton reseau externe existant
#       environment:
#         - ORTHANC__POSTGRESQL__HOST=database
#   networks:
#     database:
#       external: true
#
# =============================================================================

services:
  # =============================================================================
  # DATABASE SERVICES
  # =============================================================================

  redis:
    image: redis:8.0-alpine
    container_name: orthanc-redis
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - orthanc-network

  # ---------------------------------------------------------------------------
  # PostgreSQL embarque : marche out-of-the-box pour un clone frais.
  # Pour utiliser une DB externe, cf. la section "EXTERNAL DATABASE" en haut.
  # ---------------------------------------------------------------------------
  postgres:
    image: postgres:16-alpine
    container_name: orthanc-postgres
    restart: unless-stopped
    environment:
      - POSTGRES_DB=${POSTGRES_DB:-orthanc}
      - POSTGRES_USER=${POSTGRES_USER:-orthanc}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-orthanc}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - orthanc-network

  # =============================================================================
  # AUTHENTICATION SERVICES
  # =============================================================================
  
  auth-service:
    # Le code du service ET le frontend compile vivent DANS l'image : un tag
    # publie avant l'etat courant du depot livre un service qui ne correspond
    # pas aux fichiers du clone. C'est exactement ce qui est arrive avec le
    # tag 1.0.16, anterieur au panel : il existait dans le registre, docker
    # compose le telechargeait au lieu de construire, et /console repondait
    # 404 sur une installation pourtant fraiche.
    #
    # `pull_policy: build` impose donc la construction locale, quoi qu'il
    # traine dans le registre ou dans le cache Docker. Le nom d'image reste
    # renseigne : il sert de tag a l'image construite, et `docker compose
    # push` continue de fonctionner pour publier.
    image: registry.yokoinc.ovh/orthanc-auth-service:1.1.0
    pull_policy: build
    build:
      context: ./services/auth-service
    container_name: orthanc-auth-service
    restart: unless-stopped
    # Meme raison que pour authelia : le panel reecrit users_database.yml
    # et orthanc.json dans le depot. Les fichiers qu il cree doivent
    # appartenir a l utilisateur, pas a root.
    user: "${PUID:-1000}:${PGID:-1000}"
    volumes:
      # Bind-mounts croises : auth-service edite les MEMES fichiers host que
      # authelia et orthanc lisent. Sans ces mounts, le panel admin ecrit dans
      # le filesystem ephemere du container : les users crees ne sont jamais
      # vus par Authelia et disparaissent au restart.
      #
      # On monte les DOSSIERS, pas les fichiers. Deux raisons :
      #   1. Les ecritures sont atomiques (write tmp + rename). Un rename sur
      #      un bind-mount de fichier echoue avec EBUSY — le fichier est un
      #      point de montage, on ne peut pas le remplacer.
      #   2. Un rename cree un nouvel inode. Les autres containers qui
      #      montent le FICHIER resteraient colles a l'ancien inode et ne
      #      verraient jamais les modifications.
      - ./services/authelia/config:/host/authelia-config:rw
      - ./services/orthanc/config:/host/orthanc-config:rw
      # Backups rotatifs (10 derniers) crees avant chaque ecriture
      - ./data/admin-backups:/host/backups:rw
      # Reglages applicatifs modifiables depuis le panel (viewer par defaut,
      # langue). Volontairement separes du .env, qui ne doit contenir que ce
      # que docker compose exige AVANT de demarrer un container : secrets,
      # identifiants, PUID/PGID, SSL_MODE.
      - ./data/app-settings:/host/app-settings:rw
      # Le .env est monte en tant que FICHIER, pas via son dossier : monter la
      # racine du projet donnerait au container un acces en ecriture au
      # docker-compose.yml et aux scripts. auth-service ecrit donc sur place
      # (pas de rename, impossible sur un mount de fichier).
      # Sert au panel a changer l'URL publique ; sans ce montage l'API
      # repond 503 avec la marche a suivre, le reste fonctionne.
      - ./.env:/host/env/.env:rw
    environment:
      # Essential Configuration (from .env)
      # Repli pour les installations anterieures : la langue vit
      # desormais dans data/app-settings/settings.json et se change
      # depuis le panel. Vide ici ne signifie donc pas "anglais".
      - LANGUAGE=${LANGUAGE:-}
      - AUTH_USERNAME=${AUTH_USERNAME}
      - AUTH_PASSWORD=${AUTH_PASSWORD}
      - REDIS_HOST=redis
      # Version semantique affichee en pied de page du token manager.
      # A synchroniser avec le tag de l'image ci-dessus (1.1.0) a chaque bump.
      - IMAGE_VERSION=1.1.0
      # Compte Orthanc dedie pour POST /tools/reset (reload config a chaud).
      # Genere par bootstrap.sh dans .env.
      - ORTHANC_URL=http://orthanc:8042
      # Adresse du proxy Docker, pour le bouton de redemarrage du panel.
      # Vide = fonction indisponible, le panel l'indique alors.
      - DOCKER_PROXY_URL=http://socket-proxy:2375
      - ORTHANC_CONTAINER=orthanc-server
      - ORTHANC_ADMIN_USER=${ORTHANC_ADMIN_USER:-}
      - ORTHANC_ADMIN_PASS=${ORTHANC_ADMIN_PASS:-}
      # Optional overrides (uncomment in .env if needed)
      - LOG_LEVEL=${LOG_LEVEL:-INFO}
      - DEFAULT_TOKEN_MAX_USES=${DEFAULT_TOKEN_MAX_USES:-50}
      - DEFAULT_TOKEN_VALIDITY_SECONDS=${DEFAULT_TOKEN_VALIDITY_SECONDS:-604800}
      - CACHE_VALIDITY_USER_SESSION=${CACHE_VALIDITY_USER_SESSION:-300}
      - CACHE_VALIDITY_SHARE_TOKEN=${CACHE_VALIDITY_SHARE_TOKEN:-60}
      - AUDIT_RETENTION_DAYS=${AUDIT_RETENTION_DAYS:-90}
      - JS_REFRESH_INTERVAL=${JS_REFRESH_INTERVAL:-30000}
      - JS_DEBUG_MODE=${JS_DEBUG_MODE:-false}
    depends_on:
      redis:
        condition: service_healthy
    networks:
      - orthanc-network

  authelia:
    image: authelia/authelia:4.39.20
    container_name: orthanc-authelia
    restart: unless-stopped
    # Authelia ecrit dans ./services/authelia/config (base de sessions, liste
    # des utilisateurs). Sans cette ligne il tourne en root et s'approprie le
    # dossier : la reinstallation echoue ensuite sur un "Permission denied",
    # et les fichiers de configuration du depot deviennent illisibles pour
    # leur proprietaire. PUID/PGID sont renseignes par bootstrap.sh avec
    # l'identite de l'utilisateur courant.
    user: "${PUID:-1000}:${PGID:-1000}"
    depends_on:
      redis:
        condition: service_healthy
    volumes:
      - ./services/authelia/config:/config
    networks:
      - orthanc-network
    environment:
      - TZ=${TZ}
      - AUTHELIA_SESSION_SECRET=${AUTHELIA_SESSION_SECRET}
      - AUTHELIA_STORAGE_ENCRYPTION_KEY=${AUTHELIA_STORAGE_ENCRYPTION_KEY}
      - AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=${AUTHELIA_JWT_SECRET}
      - AUTHELIA_LOG_LEVEL=${AUTHELIA_LOG_LEVEL:-info}
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - REDIS_DB=0

  # ---------------------------------------------------------------------------
  # Redemarrage d'Orthanc depuis le panel
  # ---------------------------------------------------------------------------
  # Appliquer un changement de configuration Orthanc impose de redemarrer son
  # conteneur : l'image regenere /tmp/orthanc.json au demarrage, et c'est ce
  # fichier -- pas le notre -- que le processus lit. POST /tools/reset ne
  # relit que le fichier genere, donc ne voit aucune modification.
  #
  # A distance, un acces SSH n'est pas toujours disponible : sans ce service,
  # un changement de configuration laisse l'exploitant bloque dans son propre
  # panel.
  #
  # Le socket Docker n'est PAS monte dans auth-service. Le donner a un service
  # web reviendrait a lui accorder l'equivalent de root sur l'hote : il
  # pourrait creer un conteneur privilegie, monter la racine et en sortir. Ce
  # proxy n'expose que le strict necessaire, et n'est joignable que depuis le
  # reseau interne -- aucun port n'est publie.
  socket-proxy:
    image: tecnativa/docker-socket-proxy:0.3.0
    container_name: orthanc-socket-proxy
    restart: unless-stopped
    environment:
      # Tout est refuse par defaut. On ouvre le strict minimum :
      - POST=1            # sans quoi l'API entiere est en lecture seule
      - ALLOW_RESTARTS=1  # containers/<id>/restart (et stop, kill)
      #
      # CONTAINERS reste a 0, et c'est essentiel : avec CONTAINERS=1, POST=1
      # autorise TOUT /containers/*, dont POST /containers/create. Verifie --
      # un conteneur privilegie montant la racine de l'hote etait accepte
      # (201), soit exactement l'evasion que ce montage doit empecher. Avec
      # CONTAINERS=0, create et exec repondent 403 et le redemarrage
      # fonctionne toujours.
      - CONTAINERS=0
      # Explicitement refuses, pour que la lecture du fichier suffise a savoir
      # ce qui est possible :
      - EXEC=0            # pas d'execution de commande dans un conteneur
      - IMAGES=0
      - VOLUMES=0
      - NETWORKS=0
      - SERVICES=0
      - SWARM=0
      - SECRETS=0
      - CONFIGS=0
      - NODES=0
      - TASKS=0
      - PLUGINS=0
      - SYSTEM=0
      - INFO=0
      - AUTH=0
      - BUILD=0
      - COMMIT=0
      - DISTRIBUTION=0
      - SESSION=0
    volumes:
      # En lecture seule : le proxy n'a pas a modifier le socket lui-meme.
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - orthanc-network

  # =============================================================================
  # PACS CORE SERVICES
  # =============================================================================
  
  orthanc:
    # Official Orthanc Team image (replaces jodogne/orthanc-plugins). Pin a specific
    # tag to know exactly which plugin versions ship; see release notes at
    # https://github.com/orthanc-server/orthanc-builder/blob/master/release-notes-docker-images.md
    image: orthancteam/orthanc:26.6.1
    container_name: orthanc-server
    restart: unless-stopped
    depends_on:
      auth-service:
        condition: service_started
      postgres:
        condition: service_healthy
    volumes:
      # Dossier, pas fichier : auth-service reecrit orthanc.json via
      # write-tmp + rename, ce qui cree un nouvel inode. Un bind-mount de
      # fichier resterait colle a l'ancien inode et POST /tools/reset
      # rechargerait l'ancienne config. Orthanc scanne /etc/orthanc/*.json.
      - ./services/orthanc/config:/etc/orthanc:ro
    networks:
      - orthanc-network
    environment:
      # Env vars ORTHANC__* overrident les valeurs du orthanc.json. Ca evite
      # d'avoir a hardcoder credentials + host dans le JSON, et permet de
      # basculer d'une DB embarquee a externe juste en changeant .env / override.
      - ORTHANC__POSTGRESQL__HOST=postgres
      - ORTHANC__POSTGRESQL__PORT=5432
      - ORTHANC__POSTGRESQL__DATABASE=${POSTGRES_DB:-orthanc}
      - ORTHANC__POSTGRESQL__USERNAME=${POSTGRES_USER:-orthanc}
      - ORTHANC__POSTGRESQL__PASSWORD=${POSTGRES_PASSWORD}
      # Identifiants du plugin Authorization. Ces variables OVERRIDENT le
      # orthanc.json — Orthanc le dit au demarrage : "Authorization.
      # WebServicePassword has already been defined; it will be overwritten by
      # the value defined in env-var". bootstrap.sh ecrit les memes valeurs
      # dans le JSON, meme source (.env) : pas de desynchronisation possible.
      #
      # ATTENTION : apres avoir change AUTH_PASSWORD dans .env, il faut
      #   docker compose up -d --force-recreate orthanc
      # Un simple `restart` rejoue l'environnement fige du container : le
      # plugin garde l'ancien mot de passe, /user/get-profile repond 401 et
      # toute l'API Orthanc renvoie 403.
      - ORTHANC__AUTHORIZATION__WEB_SERVICE_USERNAME=${AUTH_USERNAME}
      - ORTHANC__AUTHORIZATION__WEB_SERVICE_PASSWORD=${AUTH_PASSWORD}
      # Kept for scripts backward compat (some helpers still read POSTGRES_*)
      - POSTGRES_HOST=postgres
      - POSTGRES_PORT=5432
      - POSTGRES_DB=${POSTGRES_DB:-orthanc}
      - POSTGRES_USER=${POSTGRES_USER:-orthanc}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      # --- Plugin enablement (orthancteam) -----------------------------------
      # orthancteam/orthanc auto-discovers bundled plugins; an env var (or a
      # config section) is required to enable each. Plugins whose orthanc.json
      # section is present (PostgreSQL, DicomWeb, Authorization, Housekeeper,
      # OrthancExplorer2) auto-enable, but we set the env vars explicitly for
      # robustness and to enable plugins without a dedicated config section
      # (Stone, VolView).
      - AUTHORIZATION_PLUGIN_ENABLED=true
      - POSTGRESQL_PLUGIN_ENABLED=true
      - DICOM_WEB_PLUGIN_ENABLED=true
      - STONE_WEB_VIEWER_PLUGIN_ENABLED=true
      - HOUSEKEEPER_PLUGIN_ENABLED=true
      - VOLVIEW_PLUGIN_ENABLED=true
      - ORTHANC_EXPLORER_2_ENABLED=true
      - GDCM_PLUGIN_ENABLED=true

  # =============================================================================
  # MEDICAL IMAGING VIEWERS
  # =============================================================================
  
  ohif:
    # SEULE EXCEPTION au `pull_policy: build` applique a auth-service et
    # nginx. Ce build est long (~15 min), OHIF etant compile depuis ses
    # sources -- l'image officielle ohif/app ne peut pas servir sous /ohif/,
    # son chemin de base etant fige au moment du build. L'imposer a chaque
    # installation couterait un quart d'heure a tout le monde.
    #
    # La contrepartie est une regle a tenir : toute modification de
    # services/ohif/ exige de publier un nouveau tag ET de le reporter ici,
    # sinon les installations continueront de tourner sur l'ancienne image
    # sans que rien ne le signale. La visionneuse ne se configure pas depuis
    # le panel, cette surface est donc restreinte et stable.
    image: registry.yokoinc.ovh/orthanc-ohif:3.11.0
    build:
      context: ./services/ohif
    container_name: orthanc-ohif
    restart: unless-stopped
    volumes:
      - ./services/ohif/config/app-config.js:/usr/share/nginx/html/ohif/app-config.js:ro
    depends_on:
      - orthanc
    networks:
      - orthanc-network

  # =============================================================================
  # REVERSE PROXY & LOAD BALANCER
  # =============================================================================
  
  nginx:
    # Image >= 1.1.0 no longer bakes the nginx config in: the templates are
    # bind-mounted from the host (see volumes below). Tags before 1.1.0 will
    # NOT start with these mounts because they expect the templates baked in.
    #
    # Les gabarits viennent du depot, mais l'ENTRYPOINT vient de l'image, et
    # c'est lui qui derive DOMAIN de PUBLIC_URL avant d'appeler envsubst. Les
    # tags anterieurs attendaient DOMAIN dans l'environnement et le laissaient
    # non exporte : envsubst rendait alors `proxy_set_header Host ;` et nginx
    # refusait de demarrer. Meme raison que pour auth-service, donc meme
    # remede : on construit toujours depuis le depot.
    image: registry.yokoinc.ovh/orthanc-nginx:1.2.0
    pull_policy: build
    build:
      context: ./services/nginx
    container_name: orthanc-nginx
    restart: unless-stopped
    ports:
      - "30080:80"
      - "30443:443"
    volumes:
      - nginx-ssl:/etc/nginx/ssl
      # Bind-mount the nginx config from the host (git = source of truth).
      # The entrypoint runs envsubst on these and writes the resulting nginx.conf
      # and conf.d/*.conf to their normal /etc/nginx/ locations. Config tweaks
      # therefore deploy via:  edit files  ->  docker compose restart nginx
      # (no rebuild, no image push, no tag bump).
      - ./services/nginx/nginx.ssl.conf:/etc/nginx/templates/nginx.conf.template:ro
      - ./services/nginx/conf.d:/etc/nginx/conf.d.templates:ro
    environment:
      # Seule variable a renseigner : l'URL publique complete. Le nom
      # d'hote (DOMAIN) en est derive par l'entrypoint.
      - PUBLIC_URL=${PUBLIC_URL}
      - SSL_MODE=${SSL_MODE:-selfsigned}
      # Optional: enables POST /api-upload/instances for scripted DICOM uploads
      # (bypasses Authelia SSO, uses HTTP Basic auth instead).
      - UPLOAD_USER=${UPLOAD_USER:-}
      - UPLOAD_PASSWORD=${UPLOAD_PASSWORD:-}
    depends_on:
      - authelia
      - orthanc
      - ohif
      - auth-service
    networks:
      - orthanc-network

# =============================================================================
# PERSISTENT STORAGE
# =============================================================================

volumes:
  nginx-ssl:
    name: orthanc_nginx_ssl
  postgres_data:
    name: orthanc_postgres_data

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

networks:
  orthanc-network:
    name: orthanc-network
    driver: bridge