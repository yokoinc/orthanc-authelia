# ORTHANC-AUTHELIA STANDALONE - Complete medical imaging solution
# Uses external PostgreSQL database container (or optional local PostgreSQL)
# Includes Redis, Orthanc, OHIF, Authelia, and Nginx
#
# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. Copy this file to docker-compose.yml:
#    cp docker-compose.yml.example docker-compose.yml
#
# 2. Copy and configure example files from the root directory:
#    cp .env.example .env
#    cp authelia-configuration.yml.example services/authelia/config/configuration.yml
#    cp authelia-users.yml.example services/authelia/config/users_database.yml
#    cp orthanc.json.example services/orthanc/config/orthanc.json
#
# 3. Edit the configuration files with your credentials:
#    - .env: Update all secrets and passwords
#    - services/authelia/config/configuration.yml: Update domain and secrets
#    - services/authelia/config/users_database.yml: Generate user passwords
#    - services/orthanc/config/orthanc.json: Update PostgreSQL credentials
#
# 4. See README.md for detailed setup instructions
#
# =============================================================================

services:
  # =============================================================================
  # DATABASE SERVICES
  # =============================================================================

  redis:
    image: redis:8.0-alpine
    container_name: orthanc-redis
    restart: unless-stopped
    # NAMED volume, and append-only persistence enabled.
    #
    # The service declared none: the redis image then creates an ANONYMOUS
    # volume for /data. It has no name, it becomes orphaned as soon as the
    # container is removed, and both `docker compose down` and `docker volume
    # prune` erase it -- along with ALL the current share links. Found on
    # 2026-08-29: 28 keys in an anonymous volume, next to 25 volumes already
    # orphaned on this NAS.
    #
    # appendonly: without it, redis only saves through snapshots (3600 1, 300
    # 100, 60 10000). A share created on its own triggers no save for an hour:
    # a hard stop in that interval loses it.
    command: redis-server --appendonly yes
    volumes:
      - redis-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      orthanc-network:
        ipv4_address: 192.168.80.11

  # ===========================================================================
  # POSTGRESQL - index and DICOM storage for Orthanc
  # ===========================================================================
  # Embedded by default. It used to be commented out, to be enabled through
  # six manual edits bootstrap.sh never mentioned: a fresh install stopped at
  # `docker compose up -d` on "network database declared as external, but
  # could not be found", then Orthanc looped on "your-postgres-username".
  # Found on the test bench on 2026-09-13.
  #
  # Password generated by bootstrap.sh into .env, copied into orthanc.json. The
  # DICOM images themselves live here (EnableStorage): the postgres_data volume
  # IS the PACS. `docker compose down -v` erases it.
  #
  # EXTERNAL DATABASE (an installation that already has its PostgreSQL): remove
  # this service and the postgres_data volume, remove postgres from orthanc's
  # depends_on, add to orthanc an external network shared with the database,
  # and fill in Host/Username/Password in services/orthanc/config/orthanc.json.
  # See docs/DATABASE_SETUP.md.
  postgres:
    image: postgres:16-alpine
    container_name: orthanc-postgres
    restart: unless-stopped
    environment:
      - POSTGRES_DB=orthanc
      - POSTGRES_USER=orthanc
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:?POSTGRES_PASSWORD missing from .env -- run ./bootstrap.sh again}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U orthanc -d orthanc"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    networks:
      orthanc-network:
        # Fixed address like the others: on a network with fixed addresses, a
        # dynamically assigned address can take that of a service not yet
        # started, which then fails with "Address already in use".
        ipv4_address: 192.168.80.18

  # =============================================================================
  # DOCKER SOCKET PROXY - lets the panel restart Orthanc
  # =============================================================================
  #
  # A configuration change only takes effect once Orthanc restarts: its image
  # merges /etc/orthanc/*.json with the ORTHANC__* variables into a copy at
  # startup, and that copy is what the process reads. Remotely, SSH is not
  # always available -- without this service the panel can write a change and
  # then leave the operator with no way to apply it.
  #
  # The Docker socket is NOT mounted into auth-service: giving it to a
  # web-facing service grants the equivalent of root on the host. It is mounted
  # here, read-only, behind a proxy whose scope is deliberately tiny.
  #
  # CONTAINERS=0 is not cosmetic. With CONTAINERS=1, POST=1 opens the whole of
  # /containers/*, POST /containers/create included -- and a privileged
  # container mounting the host root is then accepted, which is exactly the
  # escape this arrangement exists to prevent. With CONTAINERS=0, create and
  # exec answer 403 while the restart still works.
  #
  # No published port: reachable only from the internal network.
  socket-proxy:
    image: tecnativa/docker-socket-proxy:0.1.2
    container_name: orthanc-socket-proxy
    restart: unless-stopped
    environment:
      - POST=1
      - ALLOW_RESTARTS=1
      # Everything else denied, so that reading this file is enough to know
      # what is possible.
      - CONTAINERS=0
      - IMAGES=0
      - NETWORKS=0
      - VOLUMES=0
      - EXEC=0
      - SERVICES=0
      - TASKS=0
      - SECRETS=0
      - CONFIGS=0
      - SWARM=0
      - NODES=0
      - PLUGINS=0
      - SYSTEM=0
      - INFO=0
      - AUTH=0
      - BUILD=0
      - COMMIT=0
      - DISTRIBUTION=0
      - SESSION=0
      - VERSION=0
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      orthanc-network:
        ipv4_address: 192.168.80.12

  # =============================================================================
  # AUTHENTICATION SERVICES
  # =============================================================================
  
  auth-service:
    image: ghcr.io/yokoinc/orthanc-auth-service:1.2.4
    container_name: orthanc-auth-service
    restart: unless-stopped
    # /health already exists in the service; without a probe, nobody checked
    # it. It also serves as a gate for Orthanc, below.
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=5)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    # What the admin panel and the setup wizard read and write. These mounts
    # and the ADMIN_* variables below only lived in the original installation's
    # docker-compose.override.yml: a fresh install, which has no override, got
    # a wizard looking for the user database in /host/authelia.yml (the code's
    # default, a nonexistent file) and putting the administrator in the
    # "admins" group while Authelia only opens the panel to "admin". Found on
    # 2026-09-13.
    #
    # DIRECTORIES, not files: admin_module writes in place (_atomic_write),
    # which a file mounted on its own forbids (EBUSY on rename) -- see
    # docker-compose.override.yml.example.
    volumes:
      - ./services/orthanc/config:/host/orthanc:rw
      - ./services/authelia/config:/host/authelia:rw
      - ./data/admin-backups:/host/backups:rw
      # Changing the public URL from the panel. The domain lives in one line of
      # .env and in eleven places in Authelia's configuration: every
      # access_control rule, plus the session cookie block. Getting one wrong
      # leaves Authelia answering 401 on everything, login page included --
      # which is why the panel owns the change rather than a human editor.
      #
      # Mounted as a FILE, not through the project root: mounting the root
      # would give a web-facing service write access to docker-compose.yml and
      # to the scripts. Without this mount the panel disables the field and
      # says which line to add.
      #
      # This line used to sit under `environment:`: syntactically valid, hence
      # silent, and the mount never happened.
      - ./.env:/host/env/.env:rw
    environment:
      # Authelia group that opens the panel. Must match the `subject:
      # "group:admin"` rules of configuration.yml and nginx's $groups map. The
      # code's default is "admins", hence the need to set it.
      - ADMIN_GROUP=admin
      - ADMIN_ORTHANC_PATH=/host/orthanc/orthanc.json
      - ADMIN_AUTHELIA_PATH=/host/authelia/users_database.yml
      - ADMIN_AUTHELIA_CONFIG=/host/authelia/configuration.yml
      - ADMIN_BACKUPS_DIR=/host/backups
      - ADMIN_ENV_PATH=/host/env/.env
      # The panel's account on Orthanc (/system, configuration, modalities).
      # Without them, those tabs answer 503.
      - ORTHANC_URL=http://orthanc:8042
      - ORTHANC_ADMIN_USER=${ORTHANC_ADMIN_USER}
      - ORTHANC_ADMIN_PASS=${ORTHANC_ADMIN_PASS}

      # nginx ALWAYS gates /api-upload/ through /_verify-cf (nginx.ssl.conf).
      # This declares it to the panel, which cannot read nginx's configuration.
      # It only lived in the original installation's override: a fresh install
      # showed "uploads depend only on Cloudflare" while they were refused.
      - CF_ACCESS_ENFORCED=true

      # Restarting Orthanc from the panel. Leave DOCKER_PROXY_URL empty to
      # disable the feature: the panel then says so instead of offering a
      # button that cannot work.
      - DOCKER_PROXY_URL=http://socket-proxy:2375
      - ORTHANC_CONTAINER=orthanc-server
      # Essential Configuration (from .env)
      - LANGUAGE=${LANGUAGE}
      - AUTH_USERNAME=${AUTH_USERNAME}
      - AUTH_PASSWORD=${AUTH_PASSWORD}
      - REDIS_HOST=redis
      # Semantic version shown in the token manager footer. Keep it in sync
      # with the image tag above (1.2.4) on every bump.
      - IMAGE_VERSION=1.2.4
      # Optional overrides (uncomment in .env if needed)
      - LOG_LEVEL=${LOG_LEVEL:-INFO}
      - DEFAULT_TOKEN_MAX_USES=${DEFAULT_TOKEN_MAX_USES:-50}
      - DEFAULT_TOKEN_VALIDITY_SECONDS=${DEFAULT_TOKEN_VALIDITY_SECONDS:-604800}
      - CACHE_VALIDITY_USER_SESSION=${CACHE_VALIDITY_USER_SESSION:-300}
      - CACHE_VALIDITY_SHARE_TOKEN=${CACHE_VALIDITY_SHARE_TOKEN:-60}
      - AUDIT_RETENTION_DAYS=${AUDIT_RETENTION_DAYS:-90}
      - JS_REFRESH_INTERVAL=${JS_REFRESH_INTERVAL:-30000}
      - JS_DEBUG_MODE=${JS_DEBUG_MODE:-false}
    depends_on:
      redis:
        condition: service_healthy
    networks:
      orthanc-network:
        ipv4_address: 192.168.80.13

  authelia:
    image: authelia/authelia:4.39.20
    container_name: orthanc-authelia
    restart: unless-stopped
    depends_on:
      redis:
        condition: service_healthy
    volumes:
      - ./services/authelia/config:/config
    networks:
      orthanc-network:
        ipv4_address: 192.168.80.14
    environment:
      - TZ=${TZ}
      - AUTHELIA_SESSION_SECRET=${AUTHELIA_SESSION_SECRET}
      - AUTHELIA_STORAGE_ENCRYPTION_KEY=${AUTHELIA_STORAGE_ENCRYPTION_KEY}
      - AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=${AUTHELIA_JWT_SECRET}
      - AUTHELIA_LOG_LEVEL=${AUTHELIA_LOG_LEVEL:-info}
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - REDIS_DB=0

  # =============================================================================
  # PACS CORE SERVICES
  # =============================================================================
  
  orthanc:
    # Official Orthanc Team image (replaces jodogne/orthanc-plugins). Pin a specific
    # tag to know exactly which plugin versions ship; see release notes at
    # https://github.com/orthanc-server/orthanc-builder/blob/master/release-notes-docker-images.md
    image: orthancteam/orthanc:26.6.1
    container_name: orthanc-server
    restart: unless-stopped
    # Probe on /system: this route answers without authentication and requires
    # Orthanc to have really finished starting. A frozen server has not exited
    # -- without a probe it shows as "running" while nothing answers any more.
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8042/system', timeout=5)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    depends_on:
      # service_healthy, not service_started: Orthanc queries auth-service from
      # its very first requests (authorization plugin). Starting before it
      # answers produces refusals at the very moment the stack is believed
      # ready.
      auth-service:
        condition: service_healthy
      # service_healthy: Orthanc opens its PostgreSQL connection at startup and
      # exits if the database does not answer yet (volume initialisation).
      postgres:
        condition: service_healthy
    volumes:
      - ./services/orthanc/config/orthanc.json:/etc/orthanc/orthanc.json:ro
    networks:
      orthanc-network:
        ipv4_address: 192.168.80.15
    environment:
      # PostgreSQL credentials kept for backward compatibility / scripts that may
      # reference them; the actual PostgreSQL config Orthanc uses comes from
      # the "PostgreSQL" section of orthanc.json (Host/Port/Database/...).
      - POSTGRES_HOST=postgres
      - POSTGRES_PORT=5432
      - POSTGRES_DB=orthanc
      - POSTGRES_USER=orthanc
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      # --- Plugin enablement (orthancteam) -----------------------------------
      # orthancteam/orthanc auto-discovers bundled plugins; an env var (or a
      # config section) is required to enable each. Plugins whose orthanc.json
      # section is present (PostgreSQL, DicomWeb, Authorization, Housekeeper,
      # OrthancExplorer2) auto-enable, but we set the env vars explicitly for
      # robustness and to enable plugins without a dedicated config section
      # (Stone, VolView).
      - AUTHORIZATION_PLUGIN_ENABLED=true
      - POSTGRESQL_PLUGIN_ENABLED=true
      - DICOM_WEB_PLUGIN_ENABLED=true
      - STONE_WEB_VIEWER_PLUGIN_ENABLED=true
      - HOUSEKEEPER_PLUGIN_ENABLED=true
      - VOLVIEW_PLUGIN_ENABLED=true
      - ORTHANC_EXPLORER_2_ENABLED=true
      - GDCM_PLUGIN_ENABLED=true

  # =============================================================================
  # MEDICAL IMAGING VIEWERS
  # =============================================================================
  
  ohif:
    image: ghcr.io/yokoinc/orthanc-ohif:3.13.4-2
    container_name: orthanc-ohif
    restart: unless-stopped
    volumes:
      - ./services/ohif/config/app-config.js:/usr/share/nginx/html/ohif/app-config.js:ro
    depends_on:
      - orthanc
    networks:
      orthanc-network:
        ipv4_address: 192.168.80.16

  # =============================================================================
  # REVERSE PROXY & LOAD BALANCER
  # =============================================================================
  
  nginx:
    # Image >= 1.1.0 no longer bakes the nginx config in: the templates are
    # bind-mounted from the host (see volumes below). Tags before 1.1.0 will
    # NOT start with these mounts because they expect the templates baked in.
    image: ghcr.io/yokoinc/orthanc-nginx:1.1.2
    container_name: orthanc-nginx
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "nc", "-z", "127.0.0.1", "443"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    # Ports published on this machine, from .env. bootstrap.sh sets HTTPS_PORT
    # to the port of the public address: answering https://pacs.example:30003
    # used to leave the stack listening on 30443, and nothing answered.
    ports:
      - "${HTTP_PORT:-30080}:80"
      - "${HTTPS_PORT:-30443}:443"
    volumes:
      - nginx-ssl:/etc/nginx/ssl
      # Bind-mount the nginx config from the host (git = source of truth).
      # The entrypoint runs envsubst on these and writes the resulting nginx.conf
      # and conf.d/*.conf to their normal /etc/nginx/ locations. Config tweaks
      # therefore deploy via:  edit files  ->  docker compose restart nginx
      # (no rebuild, no image push, no tag bump).
      - ./services/nginx/nginx.ssl.conf:/etc/nginx/templates/nginx.conf.template:ro
      - ./services/nginx/conf.d:/etc/nginx/conf.d.templates:ro
    environment:
      - DOMAIN=${DOMAIN}
      - SSL_MODE=${SSL_MODE:-selfsigned}
      # Optional: enables POST /api-upload/instances for scripted DICOM uploads
      # (bypasses Authelia SSO, uses HTTP Basic auth instead).
      - UPLOAD_USER=${UPLOAD_USER:-}
      - UPLOAD_PASSWORD=${UPLOAD_PASSWORD:-}
    depends_on:
      - authelia
      - orthanc
      - ohif
      - auth-service
    networks:
      orthanc-network:
        ipv4_address: 192.168.80.17

  # =============================================================================
  # CLOUDFLARE TUNNEL (optional)
  # =============================================================================
  # Publishes the PACS on the Internet without opening any port on the router:
  # cloudflared dials out to Cloudflare, which serves the public HTTPS
  # certificate and renews it. Only started with the "tunnel" profile:
  # bootstrap.sh writes COMPOSE_PROFILES=tunnel into .env when it is given a
  # tunnel token. Without a token, nothing here runs.
  #
  # Public hostname, in the Cloudflare dashboard (Zero Trust -> Networks ->
  # Tunnels -> the tunnel -> Public hostname):
  #   Service          HTTPS  nginx:443
  #   No TLS Verify    on   -- nginx's certificate is self-signed, and this hop
  #                           never leaves the Docker network
  #   HTTP Host Header the public hostname
  #   HTTP2 connection on
  # See docs/CLOUDFLARE_TUNNEL.md.
  #
  # Inside the network rather than network_mode: host, with a fixed address in
  # the declared subnet: nginx only trusts CF-Connecting-IP (the visitor's real
  # address, which the rate limits count on) from that subnet.
  cloudflared:
    image: cloudflare/cloudflared:2026.9.1
    container_name: orthanc-cloudflared
    restart: unless-stopped
    profiles: ["tunnel"]
    command: tunnel --no-autoupdate run
    environment:
      - TUNNEL_TOKEN=${CLOUDFLARE_TUNNEL_TOKEN:-}
    depends_on:
      - nginx
    networks:
      orthanc-network:
        ipv4_address: 192.168.80.19

# =============================================================================
# PERSISTENT STORAGE
# =============================================================================

volumes:
  redis-data:
    name: orthanc_redis_data
  nginx-ssl:
    name: orthanc_nginx_ssl
  postgres_data:
    name: orthanc_postgres_data

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

networks:
  orthanc-network:
    name: orthanc-network
    driver: bridge
    # Declared subnet and fixed addresses, for a precise reason: nginx resolves
    # its upstreams ONCE, at startup, and keeps the result. Recreating a
    # container gives it a new one -- on this installation, authelia and
    # auth-service once swapped theirs, and nginx sent authentication requests
    # to the admin panel and vice versa. Symptom: "connect() failed (111:
    # Connection refused)" on /api/verify, no more menu in Orthanc Explorer, no
    # more session, and nothing visible on the user side.
    #
    # With fixed addresses, the resolution cached by nginx stays valid
    # indefinitely. That is preferable to dynamic resolution (resolver
    # 127.0.0.11 + a variable in proxy_pass), which would require rewriting the
    # 38 proxy_pass of nginx.ssl.conf while reproducing by hand the URI
    # semantics of each one -- a mistake on /wado or /dicom-web loses the query
    # string, hence the images, with no error message.
    #
    # This subnet is COPIED AS IS into services/nginx/nginx.ssl.conf
    # (`set_real_ip_from`): it is what allows the tunnel container to declare
    # the visitor's real address. Changing it here without carrying it over
    # there silently makes every quota fall back onto one single key.
    ipam:
      config:
        - subnet: 192.168.80.0/20
          gateway: 192.168.80.1
  # External database: declare its shared network here, for example
  #   database:
  #     external: true
  #     name: database
  # and add it to the orthanc service's networks. See the postgres block.