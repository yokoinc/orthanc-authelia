# =============================================================================
# AUTHELIA USER DATABASE
# =============================================================================
# This file is not meant to be hand-edited in normal use: the first-run
# wizard creates the administrator account, then the Users tab of the admin
# panel handles the rest (creation, groups, disabling, deletion). Authelia
# reloads the file live.
#
# Editing it by hand anyway? Generate an argon2id hash with:
#   docker run --rm authelia/authelia:4.39.5 \
#     authelia crypto hash generate argon2 --password "your-password"
#
# -----------------------------------------------------------------------------
# AVAILABLE GROUPS
# -----------------------------------------------------------------------------
# Groups do not need to exist here to be usable: they are defined by the
# access rules (configuration.yml, access_control section) and by the
# group-to-Orthanc-permissions mapping (auth_service.py). The panel offers
# these three when creating a user.
#
#   admin     full PACS administration, share token management, panel access.
#             Orthanc rights: read, write, delete, modify, anonymise, share,
#             send, settings, labels.
#   doctor    clinical use: read, upload, share, send, labels. Neither delete
#             nor settings.
#   external  restricted read-only access: viewing and downloading.
#
# -----------------------------------------------------------------------------
# BOOTSTRAP ACCOUNT
# -----------------------------------------------------------------------------
# Authelia refuses to start on an empty database:
#   "could not validate the schema: users: non zero value required"
# So at least one entry is needed before the first administrator even exists.
# That is the only purpose of the account below.
#
# It is harmless: `disabled: true` forbids any login, it belongs to no group
# and therefore holds no right, and bootstrap.sh replaces the dummy hash
# below with that of a random password never displayed nor kept.
#
# Finalising the wizard removes it once the real administrator exists. The
# installation therefore ends with no demonstration account at all.

users:
  bootstrap@localhost:
    disabled: true
    displayname: "Compte d'amorcage (supprime a la fin du wizard)"
    password: "$argon2id$v=19$m=65536,t=3,p=4$EXAMPLE_HASH_REPLACE_THIS"
    email: bootstrap@localhost
    groups: []
