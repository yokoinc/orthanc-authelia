# =============================================================================
# AUTHELIA USER DATABASE
# =============================================================================
# This file is not meant to be edited by hand in the normal case: the
# first-install wizard creates the administrator account, then the admin
# panel's Users tab manages the next ones (creation, groups, disabling,
# deletion). Authelia re-reads the file live.
#
# Manual edit anyway? Generate an argon2id hash with:
#   docker run --rm authelia/authelia:4.39.5 \
#     authelia crypto hash generate argon2 --password "your-password"
#
# -----------------------------------------------------------------------------
# AVAILABLE GROUPS
# -----------------------------------------------------------------------------
# Groups do not need to exist here to be usable: they are defined by the
# access rules (configuration.yml, access_control section) and by the
# group-to-Orthanc-permissions mapping (auth_service.py). The panel offers
# all three when creating a user.
#
#   admin     full PACS administration, share token management, panel
#             access. Orthanc permissions: read, write, delete, modify,
#             anonymize, share, send, settings, labels.
#   doctor    clinical use: read, upload, share, send, labels. No
#             deletion, no settings.
#   external  restricted read-only access: viewing and download.
#
# -----------------------------------------------------------------------------
# BOOTSTRAP ACCOUNT
# -----------------------------------------------------------------------------
# Authelia refuses to start on an empty database:
#   "could not validate the schema: users: non zero value required"
# So at least one entry is needed before the first administrator even
# exists. That is the only role of the account below.
#
# It is harmless: `disabled: true` forbids any login, it has no group hence no
# rights, and bootstrap.sh replaces the dummy hash below with that of a random
# password never displayed or kept.
#
# It remains after the wizard: our setup_finalize checks that an active
# administrator exists and sets its flag, but does no cleanup. With no rights
# and no possible login, it is inert -- deleting it from the Users tab is
# cosmetic, not a security measure.

users:
  bootstrap@localhost:
    disabled: true
    displayname: "Compte d amorcage (inerte : desactive, sans groupe)"
    password: "$argon2id$v=19$m=65536,t=3,p=4$EXAMPLE_HASH_REPLACE_THIS"
    email: bootstrap@localhost
    groups: []
