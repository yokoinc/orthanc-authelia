# =============================================================================
# AUTHELIA USER DATABASE
# =============================================================================
# Ce fichier n'est pas a editer a la main dans le cas normal : le wizard de
# premiere installation cree le compte administrateur, puis l'onglet
# Utilisateurs du panel d'administration gere les suivants (creation,
# groupes, desactivation, suppression). Authelia relit le fichier a chaud.
#
# Edition manuelle malgre tout ? Generer un hash argon2id avec :
#   docker run --rm authelia/authelia:4.39.5 \
#     authelia crypto hash generate argon2 --password "mot-de-passe"
#
# -----------------------------------------------------------------------------
# GROUPES DISPONIBLES
# -----------------------------------------------------------------------------
# Les groupes n'ont pas besoin d'exister ici pour etre utilisables : ils sont
# definis par les regles d'acces (configuration.yml, section access_control)
# et par la correspondance groupe -> droits Orthanc (auth_service.py). Le
# panel propose les trois a la creation d'un utilisateur.
#
#   admin     administration complete du PACS, gestion des jetons de partage,
#             acces au panel. Droits Orthanc : lecture, ecriture, suppression,
#             modification, anonymisation, partage, envoi, reglages, libelles.
#   doctor    usage clinique : lecture, televersement, partage, envoi,
#             libelles. Ni suppression, ni reglages.
#   external  acces restreint en lecture seule : consultation et telechargement.
#
# -----------------------------------------------------------------------------
# COMPTE D'AMORCAGE
# -----------------------------------------------------------------------------
# Authelia refuse de demarrer sur une base vide :
#   "could not validate the schema: users: non zero value required"
# Il faut donc au moins une entree avant meme que le premier administrateur
# existe. C'est le seul role du compte ci-dessous.
#
# Il est inoffensif : `disabled: true` interdit toute connexion, il n'a aucun
# groupe donc aucun droit, et bootstrap.sh remplace le hash factice ci-dessous
# par celui d'un mot de passe aleatoire jamais affiche ni conserve.
#
# La finalisation du wizard le supprime une fois le vrai administrateur cree.
# L'installation se termine donc sans aucun compte de demonstration.

users:
  bootstrap@localhost:
    disabled: true
    displayname: "Compte d'amorcage (supprime a la fin du wizard)"
    password: "$argon2id$v=19$m=65536,t=3,p=4$EXAMPLE_HASH_REPLACE_THIS"
    email: bootstrap@localhost
    groups: []
