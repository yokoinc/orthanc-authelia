# Additions au docker-compose.yml existant.
# A copier en docker-compose.override.yml (gitignore) pour surcharge automatique.
#
# Paths adaptes a la structure reelle du repo :
#   services/orthanc/config/orthanc.json         (deja bind-mounte cote orthanc)
#   services/authelia/config/                    (bind-mount du dossier entier cote authelia)
#
# ============================================================================
# Prerequis one-shot avant premier up
# ============================================================================
#
# 1) Compte Orthanc dedie a auth-service (dans .env, non-editable via UI)
#   grep -q ORTHANC_ADMIN_USER .env || cat >> .env <<'EOF'
#   ORTHANC_ADMIN_USER=svc-auth
#   ORTHANC_ADMIN_PASS=$(openssl rand -hex 32)
#   EOF
#
# 2) Dossier des backups
#   mkdir -p ./data/admin-backups
#
# 3) Routes nginx du panneau
#   Sans elles, /auth/admin et /api/admin/ tombent dans les locations /auth/
#   et /api/ qui pointent sur Authelia, et repondent 404. Les trois blocs sont
#   dans services/nginx/nginx.ssl.conf, section "ADMIN / SETUP PANEL".
#
# ============================================================================
# Pourquoi des bind-mounts de DOSSIERS et pas de fichiers
# ============================================================================
#
# On ne peut pas ecrire dans un fichier bind-mounte individuellement par un
# rename : la cible est un point de montage, le rename rend EBUSY
#   OSError [Errno 16] Device or resource busy: '/host/orthanc.json.tmp' -> '/host/orthanc.json'
# Et meme dans le cas ou il aboutirait, Docker monte par inode : orthanc, qui
# lit orthanc.json en :ro, continuerait de voir l'ancien fichier apres
# /tools/reset -- echec silencieux.
#
# admin_module ecrit donc dans l'inode existant (_atomic_write), ce qui exige
# que le DOSSIER parent soit monte. Verification apres un up :
#   ls -i services/orthanc/config/orthanc.json
#   docker exec orthanc-server ls -i /etc/orthanc/orthanc.json   # meme inode
#
# ============================================================================
# Deux options volontairement absentes
# ============================================================================
#
# - `user: "1000:1000"` : a n'ajouter que si les conteneurs tournent deja sous
#   cet UID. Basculer un stack en service de root vers 1000 casse les
#   permissions des donnees existantes. Verifier d'abord :
#     docker exec orthanc-server id
#   Sur Synology, les ACL Btrfs peuvent en plus ecraser un chown classique :
#     sudo synoacltool -del ./services/orthanc/config/orthanc.json
#     sudo chown 1000:1000 ./services/orthanc/config/orthanc.json
#     sudo chmod 660 ./services/orthanc/config/orthanc.json
#
# - `ORTHANC__AUTHENTICATION_ENABLED=true` : a n'activer que si nginx envoie un
#   header Authorization vers l'upstream orthanc. Par defaut il n'en envoie
#   aucun (l'auth passe par Authelia et le plugin Authorization) : activer
#   l'auth Basic d'Orthanc renvoie alors 401 sur l'UI, OHIF, dicom-web et
#   /api-upload/. auth-service envoie ses creds de toute facon, ils sont prets
#   pour le jour ou l'auth sera activee proprement.

services:
  auth-service:
    # Tag dedie a la branche : ne pas reutiliser un numero deja publie, deux
    # images differentes sous un meme numero est precisement ce qu'on evite.
    image: registry.yokoinc.ovh/orthanc-auth-service:1.1.0-rc1
    volumes:
      # Dossiers, pas fichiers -- cf. en-tete.
      - ./services/orthanc/config:/host/orthanc:rw
      - ./services/authelia/config:/host/authelia:rw
      - ./data/admin-backups:/host/backups:rw
    environment:
      # Nom du groupe Authelia qui ouvre le panneau. Doit concorder avec le
      # users_database.yml, le `subject: "group:..."` de la configuration
      # Authelia et la map $groups de nginx. Defaut du module : "admins".
      # Une install existante utilise souvent "admin" au singulier.
      - ADMIN_GROUP=admins
      - ADMIN_ORTHANC_PATH=/host/orthanc/orthanc.json
      - ADMIN_AUTHELIA_PATH=/host/authelia/users_database.yml
      - ADMIN_BACKUPS_DIR=/host/backups
      # Basic auth pour /tools/reset et le health check /system
      - ORTHANC_ADMIN_USER=${ORTHANC_ADMIN_USER}
      - ORTHANC_ADMIN_PASS=${ORTHANC_ADMIN_PASS}
      - ORTHANC_URL=http://orthanc:8042
      # Versions (deja injectees dans le chantier precedent)
      - IMAGE_VERSION=${IMAGE_VERSION}
      - ASSET_VERSION=${ASSET_VERSION}
