# ===============================================
# Project Specific Exclusions
# ===============================================

# Exclude sensitive configuration files (real config, not examples)
services/orthanc/config/orthanc.json
services/authelia/config/configuration.yml

# Exclude runtime data
runtime/
pid/
*.pid

# Exclude test data
test_data/
sample_data/
