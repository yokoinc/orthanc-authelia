# ORTHANC-AUTHELIA - .gitignore

# ===============================================
# Environment and Configuration
# ===============================================

# Environment variables (contains sensitive data)
#
# LISTING THE SUFFIXES DOES NOT WORK. This list used to be an enumeration
# (.env.local, .env.bak, .env.bak.*) and on 2026-08-26 it let through
# `.env.avant-rotation-20260826-040016`: the five freshly generated secrets
# ended up staged, ready to go to a PUBLIC repository, an hour after being
# changed precisely because they had leaked. A `git add -A` was enough.
#
# Rule: ignore EVERYTHING that starts with .env, and re-include by name only
# the files meant to be published.
.env
.env.*
!.env.example
!.env.*.example
# Locks taken by filelock during a panel write.
*.lock

# ===============================================
# Docker and Container Data
# ===============================================

# Docker volumes and persistent data
volumes/
data/
postgres_data/
redis_data/

# Docker build context
.dockerignore

# ===============================================
# Database Files
# ===============================================

# PostgreSQL data
*.sql
*.db
*.sqlite
*.sqlite3

# Database dumps and backups
dump.sql
backup.sql
*.dump

# ===============================================
# Logs and Monitoring
# ===============================================

# Application logs
logs/
*.log
*.log.*

# Nginx logs
access.log
error.log

# Authelia logs
authelia.log

# Orthanc logs
orthanc.log

# ===============================================
# Security and Authentication
# ===============================================

# SSL certificates and keys
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx

# Installation-specific files that carry secrets.
#
# The trailing `*` is not decorative: without it, `orthanc.json` is protected
# but `orthanc.json.bak-20260530-1002` is not, and that is exactly the copy
# that nearly went to GitHub on 2026-08-25 with the service password in clear.
# Same trap for db.sqlite3 and its timestamped backups. Every variant -- .bak,
# .save, .rotation-, .avant-rotation- -- is covered.
services/authelia/config/db.sqlite3*
services/authelia/config/notification.txt*
services/authelia/config/users_database.yml*
services/authelia/config/configuration.yml*
services/orthanc/config/orthanc.json*
docker-compose.yml
docker-compose.yml.*
docker-compose.override.yml
docker-compose.override.yml.*
!docker-compose.yml.example
!docker-compose.override.yml.example

# SSH keys
id_rsa
id_rsa.pub
*.ssh

# ===============================================
# Temporary and Cache Files
# ===============================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Cache directories
.cache/
.tmp/
tmp/
temp/

# ===============================================
# Development and Testing
# ===============================================

# Node.js (if using for development)
node_modules/
npm-debug.log
yarn-error.log
package-lock.json

# Python (if using for development)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# ===============================================
# Docker Build and Runtime
# ===============================================

# Docker compose override files
docker-compose.override.yml
docker-compose.override.yaml
docker-compose.local.yml
docker-compose.dev.yml

# Docker build artifacts
Dockerfile.dev
Dockerfile.local

# ===============================================
# Backup and Archive Files
# ===============================================

# Archive files
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.7z

# Backup files
#
# `*.bak` alone is not enough: this repository's timestamped backups are named
# `file.bak-20260530-1002`, `docker-compose.yml.save.1`,
# `orthanc.json.rotation-20260825-1632`... and the `*.bak` pattern covers none
# of them. Found on 2026-08-25: a `git add -A` would have published six files
# containing passwords in clear, including
# `services/orthanc/config/orthanc.json.bak-20260530-1002`, even though
# `orthanc.json` is correctly ignored. The file was protected, its copy was
# not.
*.bak
*.bak-*
*.bak.*
*.backup
*.backup-*
*.old
*.save
*.save.*
*.rotation-*
*.orig

# Secret bundles and one-off rotation scripts. The 2026-08-26 rotation produced
# two, both deleted since. The pattern stays for the next one, as these files
# carry secrets in clear.
.rot-bundle
rotate-secrets.sh

# ===============================================
# PACS Specific Files
# ===============================================

# DICOM files (potentially large and sensitive)
*.dcm
*.DCM
*.dicom
*.DICOM

# Medical image files
*.nii
*.nii.gz
*.img
*.hdr

# OHIF build artifacts
services/ohif/docker/*/platform/app/dist/
# Frontend build outputs, whatever the service. The pattern above only targeted
# OHIF: auth-service's Vue artifacts slipped through and got staged by a git
# add -A.
dist/
services/ohif/docker/*/platform/app/node_modules/
services/ohif/docker/*/platform/app/.next/
services/ohif/docker/*/platform/app/build/

# ===============================================
# Documentation and Reports
# ===============================================

# Generated documentation
docs/build/
docs/_build/
site/

# Report files
*.pdf
*.doc
*.docx

# ===============================================
# CI/CD and Deployment
# ===============================================

# CI definitions are NOT artifacts: .github/, .gitlab-ci.yml and the like
# describe what must run on every push. Ignoring them silently deletes the CI
# -- which is what happened here: the file existed on the GitHub line and could
# never be carried over to the NAS one.

# Deployment scripts (may contain sensitive info)
deploy.sh
production.sh

# ===============================================
# Custom Application Data
# ===============================================

# Token management data
tokens/
sessions/

# User uploads
uploads/
user_data/

# Configuration backups
config.backup/
config.old/

