# ===============================================
# Docker Registry and Images
# ===============================================

# Local Docker registry data
registry/

# Generated deployment files
docker-compose.yml

# Windows import workstation: DICOM repository credentials. config.json
# contains the URL, the account and -- for backward compatibility -- the
# password and the Cloudflare service token in clear. config.secrets.dpapi.json
# is encrypted with DPAPI, so bound to the machine AND the Windows account: it
# is meaningless elsewhere, and publishing it still amounts to publishing a
# secret.
tools/windows-dicom-import/config.json
tools/windows-dicom-import/config.secrets.dpapi.json
