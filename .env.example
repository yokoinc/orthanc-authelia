# =============================================================================
# ORTHANC-AUTHELIA ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================
# These two lines are filled in by bootstrap.sh and do not need to be edited
# by hand: the real domain is changed later from the admin panel, network
# tab, which covers the TWELVE places where it lives (here, plus the eleven
# occurrences in services/authelia/config/configuration.yml -- the eight
# access_control rules, the cookie domain, authelia_url and
# default_redirection_url). Missing a single one leaves Authelia answering
# 401 on everything, login page included.
#
# PUBLIC_URL carries the full origin, port included if it is not 443. DOMAIN
# carries only the host name, because a cookie never carries a port. PUBLIC_URL
# is MANDATORY: without it the panel refuses any domain change ("PUBLIC_URL
# absent from .env, change aborted").
PUBLIC_URL=https://pacs.localhost:30443
DOMAIN=pacs.localhost
# Ports this machine publishes. HTTPS_PORT follows the port written in
# PUBLIC_URL (bootstrap.sh sets it); an address without a port -- 443, behind a
# tunnel or a reverse proxy -- keeps the local 30443.
HTTPS_PORT=30443
HTTP_PORT=30080

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================
# Auth-service API credentials for Orthanc Authorization plugin
# Must match the credentials in services/orthanc/config/orthanc.json
AUTH_USERNAME=share-user
AUTH_PASSWORD=your-secure-password-here

# Interface language (en/fr)
LANGUAGE=en

# =============================================================================
# AUTHELIA SECURITY SECRETS
# =============================================================================
# Generate secure random values using:
# openssl rand -base64 64 | tr -d '\n'
AUTHELIA_SESSION_SECRET=generate-a-random-64-char-string-here
AUTHELIA_STORAGE_ENCRYPTION_KEY=generate-another-random-64-char-string-here
AUTHELIA_JWT_SECRET=generate-yet-another-random-64-char-string-here

# =============================================================================
# SSL CONFIGURATION
# =============================================================================
# SSL Mode Options:
#   - selfsigned: Auto-generate self-signed certificates (365-day validity)
#   - disabled: Disable SSL, use HTTP only (port 80)
#   - custom: Use your own certificates (must be placed in nginx volume)
#
# When to use each mode:
#   - selfsigned: Development, internal networks, behind Cloudflare Tunnel
#   - disabled: Behind a reverse proxy that handles SSL (Traefik, Nginx Proxy Manager)
#   - custom: Production with your own certificates (Let's Encrypt, commercial CA)
#
# Note: Certificates are stored in Docker volume 'orthanc_nginx_ssl'
SSL_MODE=selfsigned

# =============================================================================
# PROGRAMMATIC UPLOAD ENDPOINT (optional)
# =============================================================================
# Enables POST https://${DOMAIN}/api-upload/instances for automated scripts
# (e.g. importing DICOM CDs from a workstation). This endpoint BYPASSES
# Authelia SSO and uses HTTP Basic auth instead.
#
# Leave BOTH variables empty to disable the endpoint entirely (nginx will
# return 500 for /api-upload/* requests - intentional fail-closed).
#
# Recommended: use a strong, randomly generated password.
#   openssl rand -base64 24
UPLOAD_USER=
UPLOAD_PASSWORD=

# =============================================================================
# ORTHANC ACCOUNT OF THE ADMIN PANEL
# =============================================================================
# auth-service authenticates to Orthanc with this pair to reload its
# configuration (POST /tools/reset) and read /system. admin_module.py
# declares them "required env vars" at the top of the file, and the compose
# file consumes them -- but they used to be missing here: an installation
# following this template got a panel unable to query Orthanc. Filled in by
# bootstrap.sh.
ORTHANC_ADMIN_USER=svc-auth
ORTHANC_ADMIN_PASS=

# =============================================================================
# CLOUDFLARE TUNNEL (optional)
# =============================================================================
# Filled in by bootstrap.sh when you paste a tunnel token; left empty, the PACS
# is only served on this machine's ports. COMPOSE_PROFILES=tunnel is what
# starts the cloudflared container: docker compose reads it from this file.
# The token is a secret: whoever holds it can serve anything under your
# tunnel's hostnames.
CLOUDFLARE_TUNNEL_TOKEN=
COMPOSE_PROFILES=

# =============================================================================
# EMBEDDED POSTGRESQL
# =============================================================================
# Consumed by the postgres service of docker-compose.yml, and copied by
# bootstrap.sh into the PostgreSQL section of
# services/orthanc/config/orthanc.json. Filled in by bootstrap.sh. DO NOT
# change it once the database is created: PostgreSQL only reads
# POSTGRES_PASSWORD when the volume is initialised, a new password here
# would leave Orthanc without access to its own images.
POSTGRES_PASSWORD=

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================
# Timezone (see: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=UTC

# =============================================================================
# OPTIONAL: ADVANCED CONFIGURATION
# =============================================================================
# Uncomment and modify these values if you need to customize behavior
# See README.md for details

# Logging
#LOG_LEVEL=INFO

# Token defaults
#DEFAULT_TOKEN_MAX_USES=50
#DEFAULT_TOKEN_VALIDITY_SECONDS=604800

# Cache settings
#CACHE_VALIDITY_USER_SESSION=300
#CACHE_VALIDITY_SHARE_TOKEN=60

# Audit
#AUDIT_RETENTION_DAYS=90

# JavaScript settings
#JS_REFRESH_INTERVAL=30000
#JS_DEBUG_MODE=false
