# This file only holds what docker compose must know BEFORE starting a
# container: secrets, credentials, process identity, SSL mode. A setting only
# the panel uses has no business here -- it lives in
# data/app-settings/settings.json, is edited from the interface, and needs no
# restart.
#
# =============================================================================
# ORTHANC-AUTHELIA ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# =============================================================================
# PUBLIC URL
# =============================================================================
# Full public URL through which browsers reach the stack.
# This is the ONLY addressing variable to fill in: the host name used for
# cookies and Host headers is derived from it automatically.
#
# Include the port when it is not standard:
#   Production behind a reverse proxy / Cloudflare: https://pacs.example.com
#   Local dev with the compose default ports:       https://pacs.localhost:30443
#
# The host name must contain at least one dot: a domain cookie without a dot
# is refused (RFC 6265) and Authelia will not start. Locally, bootstrap.sh
# uses "pacs.localhost" -- the .localhost TLD is reserved (RFC 6761) and
# resolved to 127.0.0.1 by browsers, without touching the hosts file. Careful:
# system resolution does not always follow that rule, so use localhost:30443
# for command-line testing.
PUBLIC_URL=https://pacs.yourdomain.com

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================
# Auth-service API credentials for Orthanc Authorization plugin
# Must match the credentials in services/orthanc/config/orthanc.json
AUTH_USERNAME=share-user
AUTH_PASSWORD=your-secure-password-here

# Interface language (en/fr). Superseded by the panel setting; kept for
# installations that still rely on it.

# =============================================================================
# AUTHELIA SECURITY SECRETS
# =============================================================================
# Generate secure random values using:
# openssl rand -base64 64 | tr -d '\n'
AUTHELIA_SESSION_SECRET=generate-a-random-64-char-string-here
AUTHELIA_STORAGE_ENCRYPTION_KEY=generate-another-random-64-char-string-here
AUTHELIA_JWT_SECRET=generate-yet-another-random-64-char-string-here

# =============================================================================
# POSTGRESQL (embedded, cf docker-compose.yml.example)
# =============================================================================
# These variables are used by the compose postgres service AND by Orthanc
# (through ORTHANC__POSTGRESQL__*) to connect to the database.
# Generate a strong password with: openssl rand -base64 24
POSTGRES_DB=orthanc
POSTGRES_USER=orthanc
POSTGRES_PASSWORD=change-this-postgres-password

# =============================================================================
# SSL CONFIGURATION
# =============================================================================
# SSL Mode Options:
#   - selfsigned: Auto-generate self-signed certificates (365-day validity)
#   - disabled: Disable SSL, use HTTP only (port 80)
#   - custom: Use your own certificates (must be placed in nginx volume)
#
# When to use each mode:
#   - selfsigned: Development, internal networks, behind Cloudflare Tunnel
#   - disabled: Behind a reverse proxy that handles SSL (Traefik, Nginx Proxy Manager)
#   - custom: Production with your own certificates (Let's Encrypt, commercial CA)
#
# Note: Certificates are stored in Docker volume 'orthanc_nginx_ssl'
SSL_MODE=selfsigned

# =============================================================================
# PROGRAMMATIC UPLOAD ENDPOINT (optional)
# =============================================================================
# Enables POST <PUBLIC_URL>/api-upload/instances for automated scripts
# (e.g. importing DICOM CDs from a workstation). This endpoint BYPASSES
# Authelia SSO and uses HTTP Basic auth instead.
#
# Leave BOTH variables empty to disable the endpoint entirely (nginx will
# return 500 for /api-upload/* requests - intentional fail-closed).
#
# Recommended: use a strong, randomly generated password.
#   openssl rand -base64 24
UPLOAD_USER=
UPLOAD_PASSWORD=

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================
# Timezone (see: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=UTC

# =============================================================================
# OPTIONAL: ADVANCED CONFIGURATION
# =============================================================================
# Uncomment and modify these values if you need to customize behavior
# See README.md for details

# Logging
#LOG_LEVEL=INFO

# Token defaults
#DEFAULT_TOKEN_MAX_USES=50
#DEFAULT_TOKEN_VALIDITY_SECONDS=604800

# Cache settings
#CACHE_VALIDITY_USER_SESSION=300
#CACHE_VALIDITY_SHARE_TOKEN=60

# Audit
#AUDIT_RETENTION_DAYS=90

# JavaScript settings
#JS_REFRESH_INTERVAL=30000
#JS_DEBUG_MODE=false

# ---------------------------------------------------------------------------
# Restarting Orthanc from the admin panel
# ---------------------------------------------------------------------------
# A configuration change only takes effect once Orthanc has restarted.
# Remotely, SSH access is not always available: the socket-proxy service
# allows doing it from the panel.
#
# Leaving this empty disables the feature -- the panel then shows the command
# to run by hand. The proxy only exposes the restart: container creation and
# exec are refused (see the socket-proxy service comments in
# docker-compose.yml).
DOCKER_PROXY_URL=http://socket-proxy:2375

# Name of the Orthanc container to restart. Change it if container_name is
# modified in the compose file.
ORTHANC_CONTAINER=orthanc-server

# ---------------------------------------------------------------------------
# Identity of the containers that write into the repository
# ---------------------------------------------------------------------------
# Filled in automatically by bootstrap.sh with the current user. Without
# them, Authelia and auth-service run as root and take ownership of the
# configuration directories, which then prevents any later reinstall.
PUID=1000
PGID=1000
