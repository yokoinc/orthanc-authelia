# =============================================================================
# AUTHELIA AUTHENTICATION CONFIGURATION FOR ORTHANC-AUTHELIA
# =============================================================================
# Single Sign-On (SSO) authentication for Orthanc PACS with multi-factor support
# Generated from configuration.yml.example by setup script

---
# =============================================================================
# GENERAL CONFIGURATION
# =============================================================================

# Theme configuration - auto detects user preference (light/dark mode)
theme: auto

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
server:
  address: "tcp://0.0.0.0:9091"     # Listen on all interfaces, port 9091
  disable_healthcheck: false        # Enable health checks for Docker
  tls:
    certificate: ""                 # TLS handled by nginx reverse proxy
    key: ""
  headers:
    csp_template: ""                # Disable CSP for now
  asset_path: /config/assets        # Custom assets path for CSS overrides

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
log:
  level: ${AUTHELIA_LOG_LEVEL:-info}      # Log level from .env

# =============================================================================
# TWO-FACTOR AUTHENTICATION (TOTP)
# =============================================================================
totp:
  issuer: ORTHANC-AUTHELIA          # Issuer name displayed in authenticator apps

# =============================================================================
# USER AUTHENTICATION BACKEND
# =============================================================================
# File-based authentication for simplicity in PACS environment
authentication_backend:
  file:
    path: /config/users_database.yml # User database file location
    # Re-read the users file when it changes on disk. Without this Authelia loads
    # it once at startup, so every account the admin panel creates or deletes
    # stays invisible until the container is restarted -- a new user simply gets
    # "user not found" at login.
    watch: true
    password:
      algorithm: argon2id           # Secure password hashing algorithm
      iterations: 1                 # Hash iterations (1 for faster auth in PACS)
      salt_length: 16               # Salt length in bytes
      parallelism: 8                # Parallel threads for hashing
      memory: 128                   # Memory usage in MB
    search:
      email: true                   # Allow email-based user lookup
      case_insensitive: true        # Case-insensitive username matching

# =============================================================================
# PASSWORD POLICY
# =============================================================================
# Cette installation n'utilise QUE le mot de passe : le second facteur est
# ecarte. Le mot de passe est donc la seule chose entre Internet et des images
# de patients -- raison de plus pour exiger qu'il tienne debout.
#
# zxcvbn plutot que `standard` : il mesure la resistance reelle a une attaque
# par dictionnaire au lieu de compter des majuscules. "P@ssw0rd!" satisfait
# toutes les regles de composition classiques et tombe en quelques secondes.
# Score 3 sur 4 = "safely unguessable".
#
# Portee : les parcours d'Authelia (reinitialisation). La CREATION de comptes
# passe par le panneau, qui impose 12 caracteres minimum de son cote.
password_policy:
  standard:
    enabled: false                  # remplace par zxcvbn, plus pertinent
  zxcvbn:
    enabled: true
    min_score: 3

# =============================================================================
# ACCESS CONTROL RULES
# =============================================================================
# Define who can access what resources based on groups
access_control:
  default_policy: deny              # Deny access by default (secure)
  
  rules:
    # Admin panel - MUST stay above the bypass rule below. Rules are evaluated
    # in order and the first match wins, so "^/auth/.*$" would otherwise swallow
    # /auth/admin: Authelia would answer without a Remote-User header and the
    # panel would reject its own administrators with a 401.
    # /auth/setup is deliberately NOT listed here: at first run no account exists
    # yet, so it stays covered by the bypass below and is closed instead by the
    # setup_gate middleware in auth-service.
    # The group name must match ADMIN_GROUP on the auth-service side.
    - domain: ${AUTHELIA_DOMAIN}
      policy: one_factor
      subject: "group:admin"
      resources:
        - "^/auth/admin.*$"
        - "^/api/admin/.*$"
        - "^/auth/tokens.*$"

    # Authelia authentication pages - bypass authentication (must be accessible)
    - domain: ${AUTHELIA_DOMAIN}
      policy: bypass                # Allow without authentication
      resources:
        - "^/auth/.*$"              # Authelia login pages
        - "^/api/.*$"               # Authelia API endpoints
        - "^/static/.*$"            # Static assets
        - "^/locales/.*$"           # Localization files
        - "^/manifest.json$"        # Web app manifest
        - "^/favicon.ico$"          # Favicon
    
    # Liens de partage : contournement de l'authentification.
    #
    # ATTENTION -- ces regles se declenchent sur la SEULE PRESENCE de la chaine
    # "token=" dans l'URL. Elles ne valident rien. La validation etait censee
    # etre faite ensuite par le greffon d'autorisation d'Orthanc.
    #
    # Elle ne l'est pas. Mesure sur une installation reelle le 2026-08-27 :
    #
    #   GET https://<domaine>/dicom-web/studies?token=nimportequoi
    #     -> 200, 264 Ko, 209 etudes : noms de patients, dates, descriptions.
    #        Depuis Internet, sans compte, sans trace d'echec de connexion.
    #
    # Chaine complete : Authelia contourne ; Orthanc n'extrait PAS le parametre
    # ?token= sur /dicom-web/studies (auth-service ne le voit jamais, verifie
    # dans les journaux) ; la requete est servie sous le profil anonyme ; et
    # l'enumeration QIDO n'est gouvernee ni par les permissions ni par la
    # portee d'etiquettes -- les deux ont ete restreintes sans effet.
    #
    # Les deux regles qui donnaient acces aux DONNEES (/dicom-web et /wado) ont
    # donc ete retirees. Les trois qui restent ne servent que les visualiseurs
    # eux-memes (HTML, JS) : sans /dicom-web ni /wado, ils n'affichent aucune
    # image.
    #
    # Le partage a ete refait depuis : nginx valide le jeton par auth_request
    # vers /_verify-share (existence en base, peremption, quota) sur /dicom-web
    # et /wado, puis Orthanc en restreint le perimetre a l'etude couverte.
    # NE PAS remettre ces deux lignes de contournement : la validation se fait
    # desormais dans nginx, pas en faisant confiance a une chaine de caracteres.
    - domain: ${AUTHELIA_DOMAIN}
      policy: bypass                # Allow without authentication
      resources:
        - "^/ohif.*token=.*$"       # OHIF with token
        - "^/volview.*token=.*$"    # VolView (served at /volview/) with token
        - "^/stone-webviewer.*token=.*$"  # Stone Web Viewer with token

    # Programmatic upload endpoint - auth handled by nginx Basic auth
    # (defense in depth; nginx already doesn't call auth_request for this path)
    - domain: ${AUTHELIA_DOMAIN}
      policy: bypass
      resources:
        - "^/api-upload/.*$"        # Scripted DICOM uploads (htpasswd + rate limit at nginx)
      
    # Administrators - Full access to all PACS functions
    - domain: ${AUTHELIA_DOMAIN}
      policy: one_factor            # Require authentication (1FA)
      subject: "group:admin"
      
    # Medical doctors - Standard medical access
    - domain: ${AUTHELIA_DOMAIN}
      policy: one_factor
      subject: "group:doctor"
      
    # External users - Limited read-only access
    - domain: ${AUTHELIA_DOMAIN}
      policy: one_factor
      subject: "group:external"

# =============================================================================
# SESSION MANAGEMENT
# =============================================================================
# Optimized for medical workflow - balance between security and usability
session:
  name: authelia_session           # Session cookie name
  same_site: lax                   # Cookie same-site policy
  expiration: 1h                   # Maximum session duration
  inactivity: 15m                  # Auto-logout after inactivity
  remember_me: 8h                  # "Remember me" duration
  secret: ${AUTHELIA_SESSION_SECRET}  # Session secret from .env
  
  cookies:
    - domain: ${AUTHELIA_DOMAIN}   # Domain for session cookies
      authelia_url: https://${AUTHELIA_DOMAIN}/auth  # Authelia login URL
      default_redirection_url: https://${AUTHELIA_DOMAIN}/ui/app/  # Default redirect after login
      same_site: lax               # Cookie same-site policy
  
  # Redis backend for session storage (scales better than file storage)
  redis:
    host: ${REDIS_HOST:-redis}            # Redis container hostname
    port: ${REDIS_PORT:-6379}            # Redis port
    database_index: ${REDIS_DB:-0}    # Redis database number

# =============================================================================
# RATE LIMITING & BRUTE FORCE PROTECTION
# =============================================================================
# Protect against authentication attacks
# Sans second facteur, seule barriere contre une attaque par dictionnaire.
# 5 essais / 2 min / 5 min de bannissement laissaient ~60 tentatives par heure
# en continu, sans jamais bloquer durablement. 3 / 5 min / 15 min ramenent cela
# a une douzaine : assez tolerant pour deux fautes de frappe, assez couteux
# pour rendre l'attaque sans interet.
#
# Le bannissement vit dans db.sqlite3 : un redemarrage ne le leve pas.
regulation:
  max_retries: 3                   # Maximum failed login attempts
  find_time: 5m                    # Time window for counting failures
  ban_time: 15m                    # Ban duration after max retries

# =============================================================================
# DATA STORAGE CONFIGURATION
# =============================================================================
# Local SQLite storage for user data and authentication logs
storage:
  encryption_key: ${AUTHELIA_STORAGE_ENCRYPTION_KEY}  # Storage encryption key from .env
  local:
    path: /config/db.sqlite3       # SQLite database file location

# =============================================================================
# IDENTITY VALIDATION
# =============================================================================
# Configuration for password reset and account verification - DISABLED
# identity_validation:
#   reset_password:
#     jwt_secret: ${AUTHELIA_SESSION_SECRET}  # Session secret from .env

# =============================================================================
# NOTIFICATION SYSTEM
# =============================================================================
# File-based notifications for password resets and security alerts
notifier:
  disable_startup_check: true      # Skip email server validation on startup
  filesystem:
    filename: /config/notification.txt  # Notification log file