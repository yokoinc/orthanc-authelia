# =============================================================================
# AUTHELIA AUTHENTICATION CONFIGURATION FOR ORTHANC-AUTHELIA
# =============================================================================
# Single Sign-On (SSO) authentication for Orthanc PACS with multi-factor support
# Generated from configuration.yml.example by setup script

---
# =============================================================================
# GENERAL CONFIGURATION
# =============================================================================

# Theme configuration - auto detects user preference (light/dark mode)
theme: auto

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
server:
  address: "tcp://0.0.0.0:9091"     # Listen on all interfaces, port 9091
  disable_healthcheck: false        # Enable health checks for Docker
  tls:
    certificate: ""                 # TLS handled by nginx reverse proxy
    key: ""
  headers:
    csp_template: ""                # Disable CSP for now
  asset_path: /config/assets        # Custom assets path for CSS overrides

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
log:
  level: ${AUTHELIA_LOG_LEVEL:-info}      # Log level from .env

# =============================================================================
# TWO-FACTOR AUTHENTICATION (TOTP)
# =============================================================================
totp:
  issuer: ORTHANC-AUTHELIA          # Issuer name displayed in authenticator apps

# =============================================================================
# USER AUTHENTICATION BACKEND
# =============================================================================
# File-based authentication for simplicity in PACS environment
authentication_backend:
  # Email password reset DISABLED.
  #
  # Without SMTP, the `filesystem` notifier writes the reset link to a file
  # INSIDE the container, and the portal still shows "an email has been sent".
  # The user waits for a message that will never arrive. If you configure a
  # real SMTP server, you can set `disable` back to false.
  #
  # Otherwise: a password is changed from the admin panel, and the
  # administrator's through scripts/reset-admin-password.sh.
  #
  # MIND THE LEVEL: directly under authentication_backend, NOT under `file`.
  # Placed under `file`, Authelia refuses to start ("configuration key not
  # expected: authentication_backend.file.password_reset.disable"). This
  # template had it under `file`: every fresh install looped at startup. Found
  # on the test bench on 2026-09-13.
  password_reset:
    disable: true
  file:
    path: /config/users_database.yml # User database file location
    # Re-read the users file when it changes on disk. Without this Authelia loads
    # it once at startup, so every account the admin panel creates or deletes
    # stays invisible until the container is restarted -- a new user simply gets
    # "user not found" at login.
    watch: true
    password:
      algorithm: argon2id           # Secure password hashing algorithm
      iterations: 1                 # Hash iterations (1 for faster auth in PACS)
      salt_length: 16               # Salt length in bytes
      parallelism: 8                # Parallel threads for hashing
      memory: 128                   # Memory usage in MB
    search:
      email: true                   # Allow email-based user lookup
      case_insensitive: true        # Case-insensitive username matching

# =============================================================================
# PASSWORD POLICY
# =============================================================================
# This installation uses the password ONLY: the second factor is set aside.
# The password is therefore the only thing between the Internet and patient
# images -- all the more reason to require that it holds up.
#
# zxcvbn rather than `standard`: it measures real resistance to a dictionary
# attack instead of counting capital letters. "P@ssw0rd!" satisfies every
# classic composition rule and falls in a few seconds. Score 3 out of 4 =
# "safely unguessable".
#
# Scope: Authelia's own flows (reset). Account CREATION goes through the panel,
# which enforces a 12-character minimum on its side.
password_policy:
  standard:
    enabled: false                  # replaced by zxcvbn, more relevant
  zxcvbn:
    enabled: true
    min_score: 3

# =============================================================================
# ACCESS CONTROL RULES
# =============================================================================
# Define who can access what resources based on groups
access_control:
  default_policy: deny              # Deny access by default (secure)
  
  rules:
    # Admin panel - MUST stay above the bypass rule below. Rules are evaluated
    # in order and the first match wins, so "^/auth/.*$" would otherwise swallow
    # /auth/admin: Authelia would answer without a Remote-User header and the
    # panel would reject its own administrators with a 401.
    # /auth/setup is deliberately NOT listed here: at first run no account exists
    # yet, so it stays covered by the bypass below and is closed instead by the
    # setup_gate middleware in auth-service.
    # The group name must match ADMIN_GROUP on the auth-service side.
    - domain: ${AUTHELIA_DOMAIN}
      policy: one_factor
      subject: "group:admin"
      resources:
        - "^/auth/admin.*$"
        - "^/api/admin/.*$"
        - "^/auth/tokens.*$"

    # EXPLICIT REFUSAL of the same paths for everyone else.
    #
    # Without this rule, the panel's protection rests on ONE barrier. Rules are
    # evaluated in order and the first match wins -- but the one above carries
    # `subject: group:admin`, so it does NOT match a signed-in doctor.
    # Evaluation then continues down to the `^/auth/.*$` bypass below, which
    # allows it.
    #
    # Measured on 2026-08-29 with a real doctor account: Authelia let
    # /auth/admin and /api/admin/users through. Only the panel's require_admin
    # refused them. It was correct, but alone -- and verify_admin_auth had just
    # regressed by comparing groups by substring. A single barrier on the
    # administration of a PACS is not enough.
    #
    # This rule has NO subject: it catches everything the admin rule has not
    # already taken. It must stay exactly here -- above the bypass, below the
    # admin rule.
    #
    # Checked afterwards, both ways: a doctor gets 403 from Authelia (and no
    # longer from the panel) on /auth/admin, /api/admin/* and /auth/tokens*,
    # while an administrator gets in normally.
    - domain: ${AUTHELIA_DOMAIN}
      policy: deny
      resources:
        - "^/auth/admin.*$"
        - "^/api/admin/.*$"
        - "^/auth/tokens.*$"

    # Authelia authentication pages - bypass authentication (must be accessible)
    - domain: ${AUTHELIA_DOMAIN}
      policy: bypass                # Allow without authentication
      resources:
        - "^/auth/.*$"              # Authelia login pages
        - "^/api/.*$"               # Authelia API endpoints
        - "^/static/.*$"            # Static assets
        - "^/locales/.*$"           # Localization files
        - "^/manifest.json$"        # Web app manifest
        - "^/favicon.ico$"          # Favicon
    
    # Share links: authentication bypass.
    #
    # WARNING -- these rules trigger on the MERE PRESENCE of the string
    # "token=" in the URL. They validate nothing. Validation was supposed to be
    # done afterwards by Orthanc's authorization plugin.
    #
    # It is not. Measured on a real installation on 2026-08-27:
    #
    #   GET https://<domain>/dicom-web/studies?token=anything
    #     -> 200, 264 KB, 209 studies: patient names, dates, descriptions.
    #        From the Internet, without an account, without any failed-login trace.
    #
    # Full chain: Authelia bypasses, Orthanc does NOT extract the ?token=
    # parameter on /dicom-web/studies (auth-service never sees it, checked in
    # the logs), the request is served under the anonymous profile, and QIDO
    # enumeration is governed neither by permissions nor by label scope -- both
    # were restricted to no effect.
    #
    # The two rules that gave access to DATA (/dicom-web and /wado) were
    # therefore removed. The three that remain only serve the viewers
    # themselves (HTML, JS): without /dicom-web or /wado, they show no image.
    #
    # Sharing has been rebuilt since: nginx validates the token through
    # auth_request to /_verify-share (exists in the database, not expired,
    # quota) on /dicom-web and /wado, then Orthanc restricts the scope to the
    # covered study. DO NOT put these two bypass lines back: validation now
    # happens in nginx, not by trusting a character string.
    - domain: ${AUTHELIA_DOMAIN}
      policy: bypass                # Allow without authentication
      resources:
        - "^/ohif.*token=.*$"       # OHIF with token
        - "^/volview.*token=.*$"    # VolView (served at /volview/) with token
        - "^/stone-webviewer.*token=.*$"  # Stone Web Viewer with token

    # Programmatic upload endpoint - auth handled by nginx Basic auth
    # (defense in depth; nginx already doesn't call auth_request for this path)
    - domain: ${AUTHELIA_DOMAIN}
      policy: bypass
      resources:
        - "^/api-upload/.*$"        # Scripted DICOM uploads (htpasswd + rate limit at nginx)
      
    # Administrators - Full access to all PACS functions
    - domain: ${AUTHELIA_DOMAIN}
      policy: one_factor            # Require authentication (1FA)
      subject: "group:admin"
      
    # Medical doctors - Standard medical access
    - domain: ${AUTHELIA_DOMAIN}
      policy: one_factor
      subject: "group:doctor"
      
    # External users - Limited read-only access
    - domain: ${AUTHELIA_DOMAIN}
      policy: one_factor
      subject: "group:external"

# =============================================================================
# SESSION MANAGEMENT
# =============================================================================
# Optimized for medical workflow - balance between security and usability
session:
  name: authelia_session           # Session cookie name
  same_site: lax                   # Cookie same-site policy
  expiration: 1h                   # Maximum session duration
  inactivity: 15m                  # Auto-logout after inactivity
  remember_me: 8h                  # "Remember me" duration
  secret: ${AUTHELIA_SESSION_SECRET}  # Session secret from .env
  
  cookies:
    - domain: ${AUTHELIA_DOMAIN}   # Domain for session cookies
      # ${PUBLIC_URL} and not https://${AUTHELIA_DOMAIN}: a URL keeps its port,
      # a cookie domain never has one. Built on the domain alone, these two
      # addresses sent a local installation (port 30443) to 443, where nothing
      # listens. The panel (network tab) replaces the full origin, port
      # included, when the public address changes.
      authelia_url: ${PUBLIC_URL}/auth  # Authelia login URL
      default_redirection_url: ${PUBLIC_URL}/ui/app/  # Default redirect after login
      same_site: lax               # Cookie same-site policy
  
  # Redis backend for session storage (scales better than file storage)
  redis:
    host: ${REDIS_HOST:-redis}            # Redis container hostname
    port: ${REDIS_PORT:-6379}            # Redis port
    database_index: ${REDIS_DB:-0}    # Redis database number

# =============================================================================
# RATE LIMITING & BRUTE FORCE PROTECTION
# =============================================================================
# Protect against authentication attacks.
# Without a second factor, this is the only barrier against a dictionary
# attack. 5 attempts / 2 min / 5 min ban left ~60 attempts per hour,
# continuously, without ever blocking for long. 3 / 5 min / 15 min bring
# that down to a dozen: tolerant enough for two typos, costly enough to make
# the attack pointless.
#
# The ban lives in db.sqlite3: a restart does not lift it.
regulation:
  max_retries: 3                   # Maximum failed login attempts
  find_time: 5m                    # Time window for counting failures
  ban_time: 15m                    # Ban duration after max retries

# =============================================================================
# DATA STORAGE CONFIGURATION
# =============================================================================
# Local SQLite storage for user data and authentication logs
storage:
  encryption_key: ${AUTHELIA_STORAGE_ENCRYPTION_KEY}  # Storage encryption key from .env
  local:
    path: /config/db.sqlite3       # SQLite database file location

# =============================================================================
# IDENTITY VALIDATION
# =============================================================================
# Configuration for password reset and account verification - DISABLED
# identity_validation:
#   reset_password:
#     jwt_secret: ${AUTHELIA_SESSION_SECRET}  # Session secret from .env

# =============================================================================
# CLOCK CHECK (NTP)
# =============================================================================
# At startup Authelia compares the machine clock with an NTP server. By
# default a gap above 3 seconds is FATAL: Authelia exits, restarts, exits
# again, and every page answers 500 -- sign-in included. A machine that
# cannot reach NTP (no outbound UDP 123) fails the same way.
#
# Clock drift is ordinary: a WSL or Docker Desktop VM loses time after the
# host sleeps, a VM restored from a snapshot starts in the past. Found on
# 2026-09-14 on a fresh install under WSL Ubuntu: "the system clock is not
# synchronized accurately enough with the configured NTP server", in a loop.
#
# disable_failure keeps the check and logs the error, without refusing to
# start. This installation uses no one-time codes (TOTP), the only feature
# that really needs an exact clock.
ntp:
  disable_failure: true

# =============================================================================
# NOTIFICATION SYSTEM
# =============================================================================
# File-based notifications for password resets and security alerts
notifier:
  disable_startup_check: true      # Skip email server validation on startup
  filesystem:
    filename: /config/notification.txt  # Notification log file