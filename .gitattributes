# Line endings: LF in the working tree, whatever machine does the checkout.
# Without this file, git run from Windows (core.autocrlf=true) on the NAS
# folder rewrites the files as CRLF. It happened on 2026-08-31: 45 files
# converted, including both entrypoints -- an auth-service image built
# afterwards no longer started (#!/bin/bash\r).
* text=auto eol=lf

# Files meant for Windows: CRLF, expected by cmd.exe and PowerShell 5.1.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries: never converted.
*.png binary
*.jpg binary
*.ico binary
