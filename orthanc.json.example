{
  // =============================================================================
  // ORTHANC PACS SERVER CONFIGURATION - EXAMPLE
  // =============================================================================
  // Copy to orthanc.json and update credentials
  
  "Name": "Orthanc",
  "HttpPort": 8042,
  "HttpServerEnabled": true,
  "DicomPort": 4242,
  "DicomServerEnabled": true,
  "DicomAet": "ORTHANC",
  "DicomCheckCalledAet": false,

  // --- Who may speak DICOM to this server -----------------------------------
  // Ces quatre reglages etaient laisses implicites : Orthanc appliquait ses
  // valeurs par defaut, dont DicomAlwaysAllowStore a true -- n'importe quel
  // device, even an undeclared one, could then drop studies here. On a PACS
  // that must not hinge on a default value nobody knows about.
  //
  // Authorised devices are declared in the admin panel's Devices tab (or in
  // "DicomModalities" below).

  // Answer connectivity tests, including from an unknown device: harmless,
  // and essential to diagnose a hook-up.
  "DicomAlwaysAllowEcho": true,

  // Refuse studies from an undeclared device. This is the setting that
  // actually protects the database: leaving it true would mean accepting any
  // upload arriving on the DICOM port.
  "DicomAlwaysAllowStore": false,

  // Refuse queries and transfers from undeclared devices. These already are
  // Orthanc's defaults; they appear here so the policy reads at a glance.
  "DicomAlwaysAllowFind": false,
  "DicomAlwaysAllowMove": false,
  "DicomCheckModalityHost": false,
  "RemoteAccessAllowed": true,
  "AuthenticationEnabled": false,

  "DicomTlsEnabled": false,
  "HttpTimeout": 60,
  "HttpRequestTimeout": 30,

  "MaximumStorageSize": 0,
  "MaximumPatientCount": 0,
  "StorageCompression": false,

  // Persist DICOM modalities and Orthanc peers in the database.
  //
  // Without these two flags, any device added from the panel
  // (or through the REST API) disappears when Orthanc restarts:
  // of Orthanc: the list is re-read from this file on every start.
  //
  // The panel refuses to set them back to false, for the same reason.
  "DicomModalitiesInDatabase": true,
  "OrthancPeersInDatabase": true,

  // =============================================================================
  // POSTGRESQL - UPDATE THESE CREDENTIALS
  // =============================================================================
  "PostgreSQL": {
    "EnableIndex": true,
    "EnableStorage": true,
    "Host": "postgres",
    "Port": 5432,
    "Database": "orthanc",
    "Username": "orthanc",
    "Password": "change-this-postgres-password"
  },
  // Note: the values above are overridden at runtime by the env vars
  // ORTHANC__POSTGRESQL__* that docker-compose.yml injects from .env.
  // Editing here only has an effect if the env vars are removed from the
  // compose file.

  // No explicit "Plugins" array here: with orthancteam/orthanc, bundled plugins
  // are auto-discovered from the image's own plugin directory and enabled
  // either by their env var (AUTHORIZATION_PLUGIN_ENABLED, ...) or by the
  // presence of their config section below. The hardcoded jodogne paths like
  // /usr/local/share/orthanc/plugins/lib*.so do NOT exist in orthancteam and
  // would prevent Orthanc from starting if listed here.

  "DicomWeb": {
    "Enable": true,
    "PublicRoot": "/dicom-web/"
  },

  "Housekeeper": {
    "Enable": true,
    "GlobalPropertyId": 1024,
    "Force": false,
    "ThrottleDelay": 100,
    "Triggers": {
      "StorageCompressionChange": true,
      "MainDicomTagsChange": true,
      "UnnecessaryDicomAsJsonFiles": true,
      "DicomWebCache": true
    }
  },

  "OrthancExplorer2": {
    "Enable": true,
    "IsDefaultOrthancUI": true,
    "Theme": "dark",
    "UiOptions": {
      "ShowOrthancName": true,
      "EnableViewerQuickButton": true,
      "ViewersOrdering": ["ohif", "stone-webviewer", "volview"],
      "OhifViewer3PublicRoot": "/ohif/",
      "StoneWebViewerPublicRoot": "/stone-webviewer/",
      "VolViewPublicRoot": "/volview/",
      "EnableOpenInOhifViewer3": true,
      "EnableOpenInStoneWebViewer": true,
      "EnableOpenInVolView": true,
      "EnableShares": true,
      "DefaultShareDuration": 15,
      "ShareDurations": [0, 7, 15, 30, 90, 365],
      "StudyListColumns": [
      "PatientID", "PatientName", "StudyDate",
      "StudyDescription", "AccessionNumber",
      "InstitutionName", "Modality"
      ]
    },
    "EnableReportQuickButton": true,
    "Tokens": {
      "InstantLinksValidity": 200,
      "ShareType": "volview-viewer-publication"
    },
    "CustomButtons": {
      "studies-list": [
        {
          "HttpMethod": "GET",
          "Id": "manage-tokens",
          "Tooltip": "Manage sharing tokens (Admin)",
          "Icon": "fas fa-key",
          "Url": "/auth/tokens/manage",
          "Target": "_blank"
        },
        {
          "HttpMethod": "GET",
          "Id": "admin-panel",
          "Tooltip": "Administration (users, config, health)",
          "Icon": "fas fa-shield-halved",
          "Url": "/console/",
          "Target": "_blank"
        }
      ],
      "study": [],
      "series": [],
      "instance": []
    }
  },

  // =============================================================================
  // AUTHORIZATION - UPDATE USERNAME AND PASSWORD TO MATCH .env
  // =============================================================================
  "Authorization": {
    "CheckedLevel": "studies",
    "UncheckedFolders": ["/ui", "/favicon.ico"],
    "TokenHttpHeaders": ["X-Auth-User", "Remote-User", "auth-token"],
    "TokenGetParameters": ["token"],
    "WebServiceRootUrl": "http://auth-service:8000",
    "WebServiceTokenValidationUrl": "http://auth-service:8000/tokens/validate",
    "WebServiceUserProfileUrl": "http://auth-service:8000/user/get-profile",
    "WebServiceTokenCreationBaseUrl": "http://auth-service:8000/tokens/",
    // Credentials injected at runtime by docker-compose from .env
    // (ORTHANC__AUTHORIZATION__WEB_SERVICE_USERNAME et _PASSWORD). Les
    // values below only serve as a fallback when the env vars are absent
    // -- do not put the real password here: this file is editable from the
    // admin panel.
    "WebServiceUsername": "share-user",
    "WebServicePassword": "set-via-env-AUTH_PASSWORD",
    "StandardConfigurations": [
      "orthanc-explorer-2",
      "ohif",
      "stone-webviewer",
      "volview"
    ]
  },

  "LogLevel": "default",
  "LogFile": "",
  "HttpVerbose": false,
  "DicomVerbose": false,
  "HttpsVerifyPeers": false,
  "HttpsCACertificates": ""
}
